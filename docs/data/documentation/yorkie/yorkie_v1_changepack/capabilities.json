{"sections":[],"variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_changepack\/capabilities"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capabilities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"]"}],"externalID":"s:6Yorkie0A14_V1_ChangePackV12capabilitiesSaySSGvp","title":"capabilities","roleHeading":"Instance Property","symbolKind":"property","role":"symbol","modules":[{"name":"Yorkie"}]},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack"]]},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack\/capabilities","interfaceLanguage":"swift"},"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"capabilities is the negotiation channel for wire features a peer may not","type":"text"},{"text":" ","type":"text"},{"text":"understand. A server sets it on the pack it returns to advertise what it","type":"text"},{"text":" ","type":"text"},{"text":"supports; a client must treat absence as “unsupported” rather than as","type":"text"},{"text":" ","type":"text"},{"text":"“unknown”, because a server that predates a feature cannot say so.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capabilities","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"languages":["swift"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It exists because a server does not store the bytes a client sent: it"},{"type":"text","text":" "},{"type":"text","text":"re-encodes from its own domain model, so a field it does not know is"},{"type":"text","text":" "},{"type":"text","text":"dropped from the stored change log and the push still succeeds. Without a"},{"type":"text","text":" "},{"type":"text","text":"handshake a client cannot tell that its restore was silently downgraded to"},{"type":"text","text":" "},{"type":"text","text":"an ordinary insert. Measured against a pinned v0.7.20 server."}]}],"kind":"content"}],"references":{"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","abstract":[],"url":"\/documentation\/yorkie","kind":"symbol","role":"collection"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_ChangePack":{"abstract":[{"text":"ChangePack is a message that contains all changes that occurred in a document.","type":"text"},{"text":" ","type":"text"},{"text":"It is used to synchronize changes between clients and servers.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_ChangePack"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_ChangePack"}],"kind":"symbol","type":"topic","title":"Yorkie_V1_ChangePack","url":"\/documentation\/yorkie\/yorkie_v1_changepack"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_ChangePack/capabilities":{"role":"symbol","abstract":[{"text":"capabilities is the negotiation channel for wire features a peer may not","type":"text"},{"text":" ","type":"text"},{"text":"understand. A server sets it on the pack it returns to advertise what it","type":"text"},{"text":" ","type":"text"},{"text":"supports; a client must treat absence as “unsupported” rather than as","type":"text"},{"text":" ","type":"text"},{"text":"“unknown”, because a server that predates a feature cannot say so.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capabilities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack\/capabilities","title":"capabilities","url":"\/documentation\/yorkie\/yorkie_v1_changepack\/capabilities"}}}