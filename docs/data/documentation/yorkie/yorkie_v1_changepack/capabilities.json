{"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack\/capabilities","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capabilities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"text":"]","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It exists because a server does not store the bytes a client sent: it"},{"type":"text","text":" "},{"text":"re-encodes from its own domain model, so a field it does not know is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"dropped from the stored change log and the push still succeeds. Without a"},{"type":"text","text":" "},{"text":"handshake a client cannot tell that its restore was silently downgraded to","type":"text"},{"text":" ","type":"text"},{"text":"an ordinary insert. Measured against a pinned v0.7.20 server.","type":"text"}]}]}],"abstract":[{"type":"text","text":"capabilities is the negotiation channel for wire features a peer may not"},{"text":" ","type":"text"},{"text":"understand. A server sets it on the pack it returns to advertise what it","type":"text"},{"text":" ","type":"text"},{"text":"supports; a client must treat absence as “unsupported” rather than as","type":"text"},{"text":" ","type":"text"},{"text":"“unknown”, because a server that predates a feature cannot say so.","type":"text"}],"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capabilities","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"title":"capabilities","externalID":"s:6Yorkie0A14_V1_ChangePackV12capabilitiesSaySSGvp","roleHeading":"Instance Property","role":"symbol","symbolKind":"property","modules":[{"name":"Yorkie"}]},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_changepack\/capabilities"]}],"kind":"symbol","references":{"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","title":"Yorkie","role":"collection","url":"\/documentation\/yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_ChangePack":{"kind":"symbol","title":"Yorkie_V1_ChangePack","navigatorTitle":[{"text":"Yorkie_V1_ChangePack","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack","type":"topic","url":"\/documentation\/yorkie\/yorkie_v1_changepack","abstract":[{"type":"text","text":"ChangePack is a message that contains all changes that occurred in a document."},{"type":"text","text":" "},{"type":"text","text":"It is used to synchronize changes between clients and servers."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_ChangePack","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_ChangePack/capabilities":{"role":"symbol","abstract":[{"type":"text","text":"capabilities is the negotiation channel for wire features a peer may not"},{"text":" ","type":"text"},{"text":"understand. A server sets it on the pack it returns to advertise what it","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"supports; a client must treat absence as “unsupported” rather than as"},{"text":" ","type":"text"},{"type":"text","text":"“unknown”, because a server that predates a feature cannot say so."}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack\/capabilities","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"capabilities","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"kind":"symbol","type":"topic","title":"capabilities","url":"\/documentation\/yorkie\/yorkie_v1_changepack\/capabilities"}}}