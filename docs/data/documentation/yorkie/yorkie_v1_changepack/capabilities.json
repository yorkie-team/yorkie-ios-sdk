{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_changepack\/capabilities"]}],"metadata":{"title":"capabilities","modules":[{"name":"Yorkie"}],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capabilities","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"]","kind":"text"}],"role":"symbol","externalID":"s:6Yorkie0A14_V1_ChangePackV12capabilitiesSaySSGvp","roleHeading":"Instance Property","symbolKind":"property"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack"]]},"sections":[],"abstract":[{"text":"capabilities is the negotiation channel for wire features a peer may not","type":"text"},{"text":" ","type":"text"},{"text":"understand. A server sets it on the pack it returns to advertise what it","type":"text"},{"text":" ","type":"text"},{"text":"supports; a client must treat absence as “unsupported” rather than as","type":"text"},{"text":" ","type":"text"},{"text":"“unknown”, because a server that predates a feature cannot say so.","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"capabilities","kind":"identifier"},{"text":": [","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"It exists because a server does not store the bytes a client sent: it"},{"type":"text","text":" "},{"type":"text","text":"re-encodes from its own domain model, so a field it does not know is"},{"type":"text","text":" "},{"type":"text","text":"dropped from the stored change log and the push still succeeds. Without a"},{"type":"text","text":" "},{"type":"text","text":"handshake a client cannot tell that its restore was silently downgraded to"},{"type":"text","text":" "},{"type":"text","text":"an ordinary insert. Measured against a pinned v0.7.20 server."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack\/capabilities","interfaceLanguage":"swift"},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_ChangePack/capabilities":{"kind":"symbol","abstract":[{"type":"text","text":"capabilities is the negotiation channel for wire features a peer may not"},{"type":"text","text":" "},{"type":"text","text":"understand. A server sets it on the pack it returns to advertise what it"},{"type":"text","text":" "},{"type":"text","text":"supports; a client must treat absence as “unsupported” rather than as"},{"type":"text","text":" "},{"type":"text","text":"“unknown”, because a server that predates a feature cannot say so."}],"title":"capabilities","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"capabilities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"]"}],"type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_ChangePack\/capabilities","url":"\/documentation\/yorkie\/yorkie_v1_changepack\/capabilities"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_ChangePack":{"url":"\/documentation\/yorkie\/yorkie_v1_changepack","title":"Yorkie_V1_ChangePack","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_ChangePack"}],"abstract":[{"type":"text","text":"ChangePack is a message that contains all changes that occurred in a document."},{"type":"text","text":" "},{"text":"It is used to synchronize changes between clients and servers.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_