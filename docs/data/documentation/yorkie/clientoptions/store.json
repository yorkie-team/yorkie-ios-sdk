{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions"]]},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/store","interfaceLanguage":"swift"},"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"store"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:6Yorkie8DocStoreP","kind":"typeIdentifier","text":"DocStore"},{"kind":"text","text":")?"}],"modules":[{"name":"Yorkie"}],"role":"symbol","roleHeading":"Instance Property","externalID":"s:6Yorkie13ClientOptionsV5storeAA8DocStore_pSgvp","title":"store","symbolKind":"property"},"variants":[{"paths":["\/documentation\/yorkie\/clientoptions\/store"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"store"},{"kind":"text","text":": (any "},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","preciseIdentifier":"s:6Yorkie8DocStoreP","kind":"typeIdentifier","text":"DocStore"},{"kind":"text","text":")?"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"When set, the client writes "},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()","isActive":true,"type":"reference"},{"type":"text","text":" after every local change and"},{"type":"text","text":" "},{"type":"text","text":"restores from the store on the next attach, so changes made offline are re-pushed."},{"type":"text","text":" "},{"type":"text","text":"Leaving it "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" keeps the previous behaviour: nothing is persisted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" also set "},{"code":"key","type":"codeVoice"},{"type":"text","text":" to an opaque random value the app mints once and"},{"type":"text","text":" "},{"type":"text","text":"reuses across launches. Both the store keys and the actor recovery is keyed by are"},{"type":"text","text":" "},{"type":"text","text":"derived from it, and the default is a fresh random key per "},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client","isActive":true,"type":"reference"},{"type":"text","text":", so leaving it"},{"type":"text","text":" "},{"type":"text","text":"unset means every restart silently loses every un-pushed change and orphans the"},{"type":"text","text":" "},{"type":"text","text":"previous launch’s entries. This cannot be defaulted correctly – only the app knows"},{"type":"text","text":" "},{"type":"text","text":"what identity should outlive the process – so the client warns rather than guessing."},{"type":"text","text":" "},{"type":"text","text":"See "},{"code":"key","type":"codeVoice"},{"type":"text","text":" for why the value must not be a user id, a device id, or anything else"},{"type":"text","text":" "},{"type":"text","text":"guessable or shared between users of one device."}],"type":"paragraph"}]}],"abstract":[{"text":"The store that persists attached documents between sessions.","type":"text"}],"references":{"doc://Yorkie/documentation/Yorkie/Client":{"title":"Client","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Client"}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client","type":"topic","url":"\/documentation\/yorkie\/client","abstract":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is a normal client that can communicate with the server."},{"type":"text","text":" "},{"type":"text","text":"It has documents and sends changes of the documents in local"},{"type":"text","text":" "},{"type":"text","text":"to the server to synchronize with other replicas in remote."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}]},"doc://Yorkie/documentation/Yorkie/ClientOptions":{"kind":"symbol","title":"ClientOptions","navigatorTitle":[{"kind":"identifier","text":"ClientOptions"}],"role":"symbol","url":"\/documentation\/yorkie\/clientoptions","type":"topic","abstract":[{"type":"codeVoice","code":"ClientOptions"},{"text":" are user-settable options used when defining clients.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ClientOptions"}]},"doc://Yorkie/documentation/Yorkie/DocStore":{"role":"symbol","abstract":[{"type":"text","text":"A pluggable persistence backend for offline document state."}],"navigatorTitle":[{"text":"DocStore","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocStore","kind":"identifier"}],"kind":"symbol","type":"topic","title":"DocStore","url":"\/documentation\/yorkie\/docstore"},"doc://Yorkie/documentation/Yorkie/ClientOptions/store":{"type":"topic","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"store","kind":"identifier"},{"text":": (any ","kind":"text"},{"text":"DocStore","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie8DocStoreP"},{"text":")?","kind":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/store","role":"symbol","url":"\/documentation\/yorkie\/clientoptions\/store","title":"store","abstract":[{"text":"The store that persists attached documents between sessions.","type":"text"}]},"doc://Yorkie/documentation/Yorkie/Document/fromBytes(key:bytes:opts:)":{"role":"symbol","abstract":[{"type":"text","text":"Reconstructs a document from the bytes produced by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()"},{"text":", restoring the","type":"text"},{"type":"text","text":" "},{"text":"root, presences, checkpoint, change id, pending local changes, epoch and document id.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/fromBytes(key:bytes:opts:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"fromBytes","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"key"},{"text":": ","kind":"text"},{"text":"DocKey","preciseIdentifier":"s:6Yorkie6DocKeya","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"text":", ","kind":"text"},{"text":"opts","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Yorkie15DocumentOptionsV","text":"DocumentOptions","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:6Yorkie8DocumentC","text":"Document","kind":"typeIdentifier"}],"title":"fromBytes(key:bytes:opts:)","type":"topic","kind":"symbol","url":"\/documentation\/yorkie\/document\/frombytes(key:bytes:opts:)"},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","title":"Yorkie","role":"collection","url":"\/documentation\/yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/Document/toBytes()":{"abstract":[{"text":"Serializes the full restorable state of this document into a self-contained byte","type":"text"},{"type":"text","text":" "},{"type":"text","text":"envelope: the root and presences (as a snapshot), the checkpoint, the change id, the"},{"type":"text","text":" "},{"type":"text","text":"pending local changes, the compaction epoch, and the document id."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/fromBytes(key:bytes:opts:)"},{"type":"text","text":" reverses it, so a document survives a process restart"},{"type":"text","text":" "},{"type":"text","text":"with its un-pushed edits intact."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"toBytes"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()","role":"symbol","url":"\/documentation\/yorkie\/document\/tobytes()","title":"toBytes()","type":"topic"}}}