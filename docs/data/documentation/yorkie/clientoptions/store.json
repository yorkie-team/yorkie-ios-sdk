{"abstract":[{"type":"text","text":"The store that persists attached documents between sessions."}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"store","kind":"identifier"},{"text":": (any ","kind":"text"},{"preciseIdentifier":"s:6Yorkie8DocStoreP","text":"DocStore","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","kind":"typeIdentifier"},{"text":")?","kind":"text"}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When set, the client writes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()"},{"type":"text","text":" after every local change and"},{"type":"text","text":" "},{"type":"text","text":"restores from the store on the next attach, so changes made offline are re-pushed."},{"type":"text","text":" "},{"type":"text","text":"Leaving it "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" keeps the previous behaviour: nothing is persisted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You "},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"type":"text","text":" also set "},{"type":"codeVoice","code":"key"},{"type":"text","text":" to an opaque random value the app mints once and"},{"type":"text","text":" "},{"type":"text","text":"reuses across launches. Both the store keys and the actor recovery is keyed by are"},{"type":"text","text":" "},{"type":"text","text":"derived from it, and the default is a fresh random key per "},{"isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client","type":"reference"},{"type":"text","text":", so leaving it"},{"type":"text","text":" "},{"type":"text","text":"unset means every restart silently loses every un-pushed change and orphans the"},{"type":"text","text":" "},{"type":"text","text":"previous launch’s entries. This cannot be defaulted correctly – only the app knows"},{"type":"text","text":" "},{"type":"text","text":"what identity should outlive the process – so the client warns rather than guessing."},{"type":"text","text":" "},{"type":"text","text":"See "},{"type":"codeVoice","code":"key"},{"type":"text","text":" for why the value must not be a user id, a device id, or anything else"},{"type":"text","text":" "},{"type":"text","text":"guessable or shared between users of one device."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/store"},"metadata":{"role":"symbol","roleHeading":"Instance Property","externalID":"s:6Yorkie13ClientOptionsV5storeAA8DocStore_pSgvp","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"store"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","text":"DocStore","preciseIdentifier":"s:6Yorkie8DocStoreP"},{"kind":"text","text":")?"}],"modules":[{"name":"Yorkie"}],"title":"store"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/yorkie\/clientoptions\/store"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Yorkie/documentation/Yorkie/ClientOptions":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientOptions","kind":"identifier"}],"kind":"symbol","title":"ClientOptions","url":"\/documentation\/yorkie\/clientoptions","abstract":[{"type":"codeVoice","code":"ClientOptions"},{"type":"text","text":" are user-settable options used when defining clients."}],"navigatorTitle":[{"text":"ClientOptions","kind":"identifier"}],"role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","title":"Yorkie","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/DocStore":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","abstract":[{"text":"A pluggable persistence backend for offline document state.","type":"text"}],"url":"\/documentation\/yorkie\/docstore","type":"topic","title":"DocStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocStore"}],"navigatorTitle":[{"kind":"identifier","text":"DocStore"}],"role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yorkie/Document/fromBytes(key:bytes:opts:)":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/fromBytes(key:bytes:opts:)","abstract":[{"type":"text","text":"Reconstructs a document from the bytes produced by "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()"},{"type":"text","text":", restoring the"},{"type":"text","text":" "},{"type":"text","text":"root, presences, checkpoint, change id, pending local changes, epoch and document id."}],"url":"\/documentation\/yorkie\/document\/frombytes(key:bytes:opts:)","title":"fromBytes(key:bytes:opts:)","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fromBytes","kind":"identifier"},{"text":"(","kind":"text"},{"text":"key","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DocKey","preciseIdentifier":"s:6Yorkie6DocKeya","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"opts","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"DocumentOptions","preciseIdentifier":"s:6Yorkie15DocumentOptionsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Document","preciseIdentifier":"s:6Yorkie8DocumentC","kind":"typeIdentifier"}],"role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yorkie/ClientOptions/store":{"kind":"symbol","abstract":[{"type":"text","text":"The store that persists attached documents between sessions."}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"store"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","text":"DocStore","preciseIdentifier":"s:6Yorkie8DocStoreP"},{"kind":"text","text":")?"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/store","type":"topic","title":"store","role":"symbol","url":"\/documentation\/yorkie\/clientoptions\/store"},"doc://Yorkie/documentation/Yorkie/Document/toBytes()":{"title":"toBytes()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toBytes","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Serializes the full restorable state of this document into a self-contained byte"},{"type":"text","text":" "},{"type":"text","text":"envelope: the root and presences (as a snapshot), the checkpoint, the change id, the"},{"type":"text","text":" "},{"type":"text","text":"pending local changes, the compaction epoch, and the document id."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/fromBytes(key:bytes:opts:)"},{"type":"text","text":" reverses it, so a document survives a process restart"},{"type":"text","text":" "},{"type":"text","text":"with its un-pushed edits intact."}],"url":"\/documentation\/yorkie\/document\/tobytes()","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Client":{"kind":"symbol","abstract":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is a normal client that can communicate with the server."},{"type":"text","text":" "},{"type":"text","text":"It has documents and sends changes of the documents in local"},{"type":"text","text":" "},{"type":"text","text":"to the server to synchronize with other replicas in remote."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"navigatorTitle":[{"kind":"identifier","text":"Client"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client","type":"topic","title":"Client","role":"symbol","url":"\/documentation\/yorkie\/client"}}}