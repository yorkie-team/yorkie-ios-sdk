{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/store"},"abstract":[{"type":"text","text":"The store that persists attached documents between sessions."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"store"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:6Yorkie8DocStoreP","kind":"typeIdentifier","text":"DocStore","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"},{"kind":"text","text":")?"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"When set, the client writes ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()"},{"text":" after every local change and","type":"text"},{"text":" ","type":"text"},{"text":"restores from the store on the next attach, so changes made offline are re-pushed.","type":"text"},{"text":" ","type":"text"},{"text":"Leaving it ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" keeps the previous behaviour: nothing is persisted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"text":" also set ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" to an opaque random value the app mints once and","type":"text"},{"text":" ","type":"text"},{"text":"reuses across launches. Both the store keys and the actor recovery is keyed by are","type":"text"},{"text":" ","type":"text"},{"text":"derived from it, and the default is a fresh random key per ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client"},{"text":", so leaving it","type":"text"},{"text":" ","type":"text"},{"text":"unset means every restart silently loses every un-pushed change and orphans the","type":"text"},{"text":" ","type":"text"},{"text":"previous launch’s entries. This cannot be defaulted correctly – only the app knows","type":"text"},{"text":" ","type":"text"},{"text":"what identity should outlive the process – so the client warns rather than guessing.","type":"text"},{"text":" ","type":"text"},{"text":"See ","type":"text"},{"type":"codeVoice","code":"key"},{"text":" for why the value must not be a user id, a device id, or anything else","type":"text"},{"text":" ","type":"text"},{"text":"guessable or shared between users of one device.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions"]]},"variants":[{"paths":["\/documentation\/yorkie\/clientoptions\/store"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"store","kind":"identifier"},{"text":": (any ","kind":"text"},{"text":"DocStore","preciseIdentifier":"s:6Yorkie8DocStoreP","kind":"typeIdentifier"},{"text":")?","kind":"text"}],"title":"store","modules":[{"name":"Yorkie"}],"externalID":"s:6Yorkie13ClientOptionsV5storeAA8DocStore_pSgvp","roleHeading":"Instance Property","symbolKind":"property","role":"symbol"},"references":{"doc://Yorkie/documentation/Yorkie/Document/fromBytes(key:bytes:opts:)":{"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"fromBytes"},{"kind":"text","text":"("},{"kind":"externalParam","text":"key"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Yorkie6DocKeya","kind":"typeIdentifier","text":"DocKey"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"preciseId