 "},{"type":"text","text":"envelope: the root and presences (as a snapshot), the checkpoint, the change id, the"},{"text":" ","type":"text"},{"type":"text","text":"pending local changes, the compaction epoch, and the document id."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/fromBytes(key:bytes:opts:)","isActive":true},{"text":" reverses it, so a document survives a process restart","type":"text"},{"text":" ","type":"text"},{"text":"with its un-pushed edits intact.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"toBytes","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"}],"title":"toBytes()","role":"symbol"}}}