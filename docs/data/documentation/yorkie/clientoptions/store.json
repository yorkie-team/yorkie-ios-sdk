entation\/Yorkie\/ClientOptions\/store","type":"topic","title":"store","url":"\/documentation\/yorkie\/clientoptions\/store","kind":"symbol","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","abstract":[],"url":"\/documentation\/yorkie","kind":"symbol","role":"collection"},"doc://Yorkie/documentation/Yorkie/ClientOptions":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientOptions","kind":"identifier"}],"title":"ClientOptions","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions","abstract":[{"type":"codeVoice","code":"ClientOptions"},{"type":"text","text":" are user-settable options used when defining clients."}],"kind":"symbol","navigatorTitle":[{"text":"ClientOptions","kind":"identifier"}],"url":"\/documentation\/yorkie\/clientoptions","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Document/toBytes()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"toBytes","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DataV","text":"Data","kind":"typeIdentifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/toBytes()","abstract":[{"type":"text","text":"Serializes the full restorable state of this document into a self-contained byte"},{"type":"text","text":" "},{"type":"text","text":"envelope: the root and presences (as a snapshot), the checkpoint, the change id, the"},{"type":"text","text":" "},{"type":"text","text":"pending local changes, the compaction epoch, and the document id."},{"type":"text","text":" "},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/fromBytes(key:bytes:opts:)","isActive":true,"type":"reference"},{"type":"text","text":" reverses it, so a document survives a process restart"},{"type":"text","text":" "},{"type"