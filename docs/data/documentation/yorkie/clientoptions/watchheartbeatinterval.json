{"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/watchHeartbeatInterval"},"kind":"symbol","metadata":{"modules":[{"name":"Yorkie"}],"title":"watchHeartbeatInterval","roleHeading":"Instance Property","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"externalID":"s:6Yorkie13ClientOptionsV22watchHeartbeatIntervalSivp","role":"symbol"},"abstract":[{"type":"text","text":"The interval, in milliseconds, at which the client asks the server to send a heartbeat on"},{"type":"text","text":" "},{"type":"text","text":"an idle Watch stream. The default is "},{"type":"codeVoice","code":"20000"},{"type":"text","text":" (20 seconds)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"The server clamps the request into its own bounds (5 to 60 seconds by default) and echoes","type":"text"},{"text":" ","type":"text"},{"text":"the effective value back when the stream starts; that echoed value is what arms the idle","type":"text"},{"text":" ","type":"text"},{"text":"watchdog, which reconnects a stream that stays silent for several intervals. Like the other","type":"text"},{"text":" ","type":"text"},{"text":"interval options, the unit is milliseconds, not seconds. Zero or a negative value opts out:","type":"text"},{"text":" ","type":"text"},{"text":"the client asks for no heartbeat and the stream then has no idle watchdog. A value too large","type":"text"},{"text":" ","type":"text"},{"text":"for the wire is capped rather than rejected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This needs server support (v0.7.25 or later). An older server ignores the request.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/yorkie\/clientoptions\/watchheartbeatinterval"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Yorkie/documentation/Yorkie/ClientOptions/watchHeartbeatInterval":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/watchHeartbeatInterval","url":"\/documentation\/yorkie\/clientoptions\/watchheartbeatinterval","abstract":[{"type":"text","text":"The interval, in milliseconds, at which the client asks the server to send a heartbeat on"},{"type":"text","text":" "},{"type":"text","text":"an idle Watch stream. The default is "},{"code":"20000","type":"codeVoice"},{"type":"text","text":" (20 seconds)."}],"type":"topic","title":"watchHeartbeatInterval","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yorkie/ClientOptions":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientOptions","kind":"identifier"}],"kind":"symbol","title":"ClientOptions","url":"\/documentation\/yorkie\/clientoptions","abstract":[{"type":"codeVoice","code":"ClientOptions"},{"type":"text","text":" are user-settable options used when defining clients."}],"navigatorTitle":[{"text":"ClientOptions","kind":"identifier"}],"role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","title":"Yorkie","url":"\/documentation\/yorkie"}}}