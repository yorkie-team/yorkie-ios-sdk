{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/clientoptions\/watchheartbeatinterval"]}],"metadata":{"title":"watchHeartbeatInterval","modules":[{"name":"Yorkie"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"role":"symbol","externalID":"s:6Yorkie13ClientOptionsV22watchHeartbeatIntervalSivp","roleHeading":"Instance Property","symbolKind":"property"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions"]]},"sections":[],"abstract":[{"text":"The interval, in milliseconds, at which the client asks the server to send a heartbeat on","type":"text"},{"text":" ","type":"text"},{"text":"an idle Watch stream. The default is ","type":"text"},{"type":"codeVoice","code":"20000"},{"text":" (20 seconds).","type":"text"}],"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The server clamps the request into its own bounds (5 to 60 seconds by default) and echoes"},{"type":"text","text":" "},{"type":"text","text":"the effective value back when the stream starts; that echoed value is what arms the idle"},{"type":"text","text":" "},{"type":"text","text":"watchdog, which reconnects a stream that stays silent for several intervals. Like the other"},{"type":"text","text":" "},{"type":"text","text":"interval options, the unit is milliseconds, not seconds. Zero or a negative value opts out:"},{"type":"text","text":" "},{"type":"text","text":"the client asks for no heartbeat and the stream then has no idle watchdog. A value too large"},{"type":"text","text":" "},{"type":"text","text":"for the wire is capped rather than rejected."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This needs server support (v0.7.25 or later). An older server ignores the request."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/watchHeartbeatInterval"},"references":{"doc://Yorkie/documentation/Yorkie/ClientOptions":{"title":"ClientOptions","navigatorTitle":[{"text":"ClientOptions","kind":"identifier"}],"url":"\/documentation\/yorkie\/clientoptions","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientOptions","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"ClientOptions"},{"type":"text","text":" are user-settable options used when defining clients."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions","role":"symbol"},"doc://Yorkie/documentation/Yorkie/ClientOptions/watchHeartbeatInterval":{"url":"\/documentation\/yorkie\/clientoptions\/watchheartbeatinterval","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"watchHeartbeatInterval","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/watchHeartbeatInterval","kind":"symbol","type":"topic","role":"symbol","abstract":[{"type":"text","text":"The interval, in milliseconds, at which the client asks the server to send a heartbeat on"},{"type":"text","text":" "},{"type":"text","text":"an idle Watch stream. The default is "},{"type":"codeVoice","code":"20000"},{"type":"text","text":" (20 seconds)."}],"title":"watchHeartbeatInterval"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","url":"\/documentation\/yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","role":"collection","abstract":[],"type":"topic"}}}