{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The server clamps the request into its own bounds (5 to 60 seconds by default) and echoes","type":"text"},{"text":" ","type":"text"},{"text":"the effective value back when the stream starts; that echoed value is what arms the idle","type":"text"},{"text":" ","type":"text"},{"text":"watchdog, which reconnects a stream that stays silent for several intervals. Like the other","type":"text"},{"text":" ","type":"text"},{"text":"interval options, the unit is milliseconds, not seconds. Zero or a negative value opts out:","type":"text"},{"text":" ","type":"text"},{"text":"the client asks for no heartbeat and the stream then has no idle watchdog. A value too large","type":"text"},{"text":" ","type":"text"},{"text":"for the wire is capped rather than rejected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This needs server support (v0.7.25 or later). An older server ignores the request.","type":"text"}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/watchHeartbeatInterval","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Property","externalID":"s:6Yorkie13ClientOptionsV22watchHeartbeatIntervalSivp","symbolKind":"property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"}],"title":"watchHeartbeatInterval","modules":[{"name":"Yorkie"}],"role":"symbol"},"variants":[{"paths":["\/documentation\/yorkie\/clientoptions\/watchheartbeatinterval"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions"]]},"abstract":[{"type":"text","text":"The interval, in milliseconds, at which the client asks the server to send a heartbeat on"},{"type":"text","text":" "},{"type":"text","text":"an idle Watch stream. The default is "},{"type":"codeVoice","code":"20000"},{"type":"text","text":" (20 seconds)."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Yorkie/documentation/Yorkie/ClientOptions":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ClientOptions","kind":"identifier"}],"title":"ClientOptions","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions","abstract":[{"type":"codeVoice","code":"ClientOptions"},{"type":"text","text":" are user-settable options used when defining clients."}],"kind":"symbol","navigatorTitle":[{"text":"ClientOptions","kind":"identifier"}],"url":"\/documentation\/yorkie\/clientoptions","role":"symbol"},"doc://Yorkie/documentation/Yorkie/ClientOptions/watchHeartbeatInterval":{"type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"watchHeartbeatInterval"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/ClientOptions\/watchHeartbeatInterval","abstract":[{"text":"The interval, in milliseconds, at which the client asks the server to send a heartbeat on","type":"text"},{"text":" ","type":"text"},{"text":"an idle Watch stream. The default is ","type":"text"},{"code":"20000","type":"codeVoice"},{"text":" (20 seconds).","type":"text"}],"title":"watchHeartbeatInterval","kind":"symbol","url":"\/documentation\/yorkie\/clientoptions\/watchheartbeatinterval","role":"sym