{"metadata":{"role":"symbol","externalID":"s:6Yorkie0A15_V1_RestoreModeO","roleHeading":"Enumeration","modules":[{"name":"Yorkie"}],"navigatorTitle":[{"text":"Yorkie_V1_RestoreMode","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Yorkie_V1_RestoreMode"}],"title":"Yorkie_V1_RestoreMode","symbolKind":"enum"},"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/Yorkie\/s12CaseIterableP","doc:\/\/Yorkie\/s8CopyableP","doc:\/\/Yorkie\/SQ","doc:\/\/Yorkie\/s9EscapableP","doc:\/\/Yorkie\/SH","doc:\/\/Yorkie\/SY","doc:\/\/Yorkie\/s8SendableP","doc:\/\/Yorkie\/s16SendableMetatypeP","doc:\/\/Yorkie\/13SwiftProtobuf4EnumP"],"title":"Conforms To","kind":"relationships","type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie"]]},"sections":[],"topicSections":[{"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/UNRECOGNIZED(_:)","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/restore","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/retombstone","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/unspecified"],"anchor":"Enumeration-Cases","generated":true,"title":"Enumeration Cases"},{"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/init()","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/init(rawValue:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/rawValue-swift.property"],"anchor":"Instance-Properties","generated":true,"title":"Instance Properties"},{"title":"Type Aliases","anchor":"Type-Aliases","generated":true,"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/RawValue-swift.typealias"]},{"title":"Type Properties","anchor":"Type-Properties","generated":true,"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/allCases"]},{"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/Equatable-Implementations","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/Hashable-Implementations","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/RawRepresentable-Implementations"],"anchor":"Default-Implementations","generated":true,"title":"Default Implementations"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_RestoreMode"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"For elements it selects between reviving the element already in the tree and"},{"text":" ","type":"text"},{"type":"text","text":"inserting a copy of it. The copy is what undo does today, and because a"},{"type":"text","text":" "},{"type":"text","text":"deep copy keeps every descendant’s created_at, it puts a second live element"},{"type":"text","text":" "},{"type":"text","text":"under ids the document is indexed by. Reviving needs a replicated liveness"},{"text":" ","type":"text"},{"text":"register – removed_at paired with revived_at on each element – so that","type":"text"},{"text":" ","type":"text"},{"text":"every replica resolves a remove\/revive race the same way, with a tie going","type":"text"},{"text":" ","type":"text"},{"text":"to the removal as the shipped remove register already does.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The branch cannot be chosen from local state. A replica that collected","type":"text"},{"text":" ","type":"text"},{"text":"between the removal and the undo has purged the tombstone, and one that","type":"text"},{"text":" ","type":"text"},{"text":"joined from a later snapshot never had it, so “revive if a tombstone is","type":"text"},{"text":" ","type":"text"},{"text":"present” is a function of local collection timing and the same change log","type":"text"},{"text":" ","type":"text"},{"text":"would produce different documents. That is why the branch is on the wire.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"RestoreMode selects the identity-preserving path. RESTORE_MODE_UNSPECIFIED","type":"text"},{"type":"text","text":" "},{"text":"means an ordinary edit (no restore semantics), keeping forward edits","type":"text"},{"text":" ","type":"text"},{"text":"unchanged on the wire.","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_restoremode"]}],"references":{"doc://Yorkie/SH":{"identifier":"doc:\/\/Yorkie\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://Yorkie/s8CopyableP":{"identifier":"doc:\/\/Yorkie\/s8CopyableP","title":"Swift.Copyable","type":"unresolvable"},"doc://Yorkie/s9EscapableP":{"identifier":"doc:\/\/Yorkie\/s9EscapableP","title":"Swift.Escapable","type":"unresolvable"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_RestoreMode/UNRECOGNIZED(_:)":{"role":"symbol","type":"topic","url":"\/documentation\/yorkie\/yorkie_v1_restoremode\/unrecognized(_:)","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"UNRECOGNIZED"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Int","preciseIdentifier":"s:Si"},{"kind":"text","text":")"}],"title":"Yorkie_V1_RestoreMode.UNRECOGNIZED(_:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_RestoreMode\/UNRECOGNIZED(_:)","kind":"symbol","abstract":[]},"doc://Yorkie/s12CaseIterableP":{"identifier":"doc:\/\/Yorkie\/s12CaseIterableP","title":"Swift.CaseIterable","type":"unresolvable"},"doc://Yorkie/s16SendableMetatypeP":{"identifier":"doc:\/\/Yorkie\/s16SendableM