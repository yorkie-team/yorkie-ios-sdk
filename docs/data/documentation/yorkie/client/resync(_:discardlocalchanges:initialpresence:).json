{"abstract":[{"text":"Recovers a document whose local writes the server has refused, without dropping the","type":"text"},{"text":" ","type":"text"},{"text":"client and the ","type":"text"},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document","isActive":true,"type":"reference"},{"text":".","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resync","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"doc","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Document","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document","preciseIdentifier":"s:6Yorkie8DocumentC"},{"text":", ","kind":"text"},{"text":"discardLocalChanges","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"initialPresence","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"PresenceData","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/PresenceData","preciseIdentifier":"s:6Yorkie12PresenceDataa"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"DroppedChange","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DroppedChange","preciseIdentifier":"s:6Yorkie13DroppedChangeV"},{"text":"]","kind":"text"}]}],"kind":"declarations"},{"parameters":[{"name":"doc","content":[{"inlineContent":[{"text":"The attached document to recover.","type":"text"}],"type":"paragraph"}]},{"name":"discardLocalChanges","content":[{"inlineContent":[{"text":"Must be ","type":"text"},{"code":"true","type":"codeVoice"},{"text":". The un-pushed changes are taken out of the queue","type":"text"},{"text":" ","type":"text"},{"text":"and returned instead of being sent again; there is no non-discarding form, and the","type":"text"},{"text":" ","type":"text"},{"text":"argument keeps the data loss visible at the call site.","type":"text"}],"type":"paragraph"}]},{"name":"initialPresence","content":[{"inlineContent":[{"type":"text","text":"The presence to re-attach with. Defaults to the document’s current"},{"type":"text","text":" "},{"type":"text","text":"presence, so the user keeps their cursor: presence is not what the server refused."}],"type":"paragraph"}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"text":"Return Value","anchor":"return-value","type":"heading"},{"inlineContent":[{"type":"text","text":"The discarded changes, so the app can report them. Re-applying them is"},{"type":"text","text":" "},{"type":"text","text":"deliberately not the default."}],"type":"paragraph"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"An auth webhook that starts denying writes mid-session (a locked document, a member"},{"type":"text","text":" "},{"type":"text","text":"downgraded to read-only, a revoked share link) leaves the refused changes in the queue."},{"type":"text","text":" "},{"type":"text","text":"Push and pull share one RPC, so every later sync re-sends them, is denied again, and the"},{"type":"text","text":" "},{"type":"text","text":"client stops receiving other peers’ changes too. The refused changes cannot be undone in"},{"type":"text","text":" "},{"type":"text","text":"place either: they are already applied to the root and there is no server-confirmed copy"},{"text":" ","type":"text"},{"text":"to fall back on. Recovery therefore re-anchors the same ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document","isActive":true},{"text":" instance on the","type":"text"},{"text":" ","type":"text"},{"text":"server state:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Wait out any in-flight sync, then drop offline persistence and take the un-pushed","type":"text"},{"text":" ","type":"text"},{"text":"changes out of the queue.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Detach without the presence-clear change a detach normally mints, so the pack carries","type":"text"},{"type":"text","text":" "},{"type":"text","text":"no changes a webhook could refuse and the "},{"code":"clientSeq","type":"codeVoice"},{"type":"text","text":" counter never has to be rewound."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset the document for re-anchoring and attach it again under the sync mode, garbage"},{"type":"text","text":" "},{"text":"collection option and poll interval it had, with the presence it held.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Restart the sync loop that the denial stopped."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Keeping the instance is the point: the app’s subscriptions and the editor bound to the"},{"type":"text","text":" "},{"text":"document survive. Between the discard and the re-anchor the queue has a ","type":"text"},{"code":"clientSeq","type":"codeVoice"},{"text":" hole","type":"text"},{"text":" ","type":"text"},{"text":"no new change may be minted over, so the discard suspends minting: ","type":"text"},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/update(_:_:)","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/undo()"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/redo()"},{"type":"text","text":" throw "},{"code":"YorkieError\/Code\/errRefused","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/isMintable"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":" until the re-anchor. An edit made before the discard is"},{"type":"text","text":" "},{"type":"text","text":"part of the discarded set and is reported with the rest."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A detach the server refuses restores the queue and leaves the document attached as it was,"},{"type":"text","text":" "},{"type":"text","text":"so the call can be retried. Offline persistence is the exception, as in yorkie-js-sdk: it"},{"type":"text","text":" "},{"type":"text","text":"is torn down before the detach and stays down until the next attach. Past the detach the changes are gone for good and are published"},{"type":"text","text":" "},{"type":"text","text":"as a "},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedEvent","isActive":true},{"type":"text","text":" with reason "},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedValue\/Reason-swift.enum\/writeDenied","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"before the re-attach, which can still fail."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The whole recovery runs under the client’s sync semaphore, so no sync can start or be in"},{"type":"text","text":" "},{"type":"text","text":"flight while the queue is touched."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Automatic recovery on attach denials and watch denials is not part of this call."}],"type":"paragraph"},{"style":"note","name":"Throws","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"YorkieError\/Code\/errClientNotActivated"},{"type":"text","text":" when the client is not active,"},{"type":"text","text":" "},{"type":"codeVoice","code":"YorkieError\/Code\/errNotAttached"},{"type":"text","text":" when the document is not attached,"},{"type":"text","text":" "},{"type":"codeVoice","code":"YorkieError\/Code\/errInvalidArgument"},{"type":"text","text":" when "},{"type":"codeVoice","code":"discardLocalChanges"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or the"},{"type":"text","text":" "},{"type":"text","text":"error of the detach or the re-attach."}],"type":"paragraph"}],"type":"aside"}]}],"metadata":{"role":"symbol","externalID":"s:6Yorkie6ClientC6resync_19discardLocalChanges15initialPresenceSayAA13DroppedChangeVGAA8DocumentC_SbSDySSSe_SEpGSgtYaKF","extendedModule":"Yorkie","roleHeading":"Instance Method","title":"resync(_:discardLocalChanges:initialPresence:)","modules":[{"name":"Yorkie"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resync"},{"kind":"text","text":"("},{"preciseIdentifier":"s:6Yorkie8DocumentC","kind":"typeIdentifier","text":"Document"},{"kind":"text","text":", "},{"kind":"externalParam","text":"discardLocalChanges"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initialPresence"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Yorkie12PresenceDataa","kind":"typeIdentifier","text":"PresenceData"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"preciseIdentifier":"s:6Yorkie13DroppedChangeV","kind":"typeIdentifier","text":"DroppedChange"},{"kind":"text","text":"]"}]},"variants":[{"paths":["\/documentation\/yorkie\/client\/resync(_:discardlocalchanges:initialpresence:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Client"]]},"sections":[],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/resync(_:discardLocalChanges:initialPresence:)","interfaceLanguage":"swift"},"references":{"doc://Yorkie/documentation/Yorkie/Document/update(_:_:)":{"role":"symbol","type":"topic","url":"\/documentation\/yorkie\/document\/update(_:_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"(("},{"preciseIdentifier":"s:6Yorkie10JSONObjectC","kind":"typeIdentifier","text":"JSONObject"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"preciseIdentifier":"s:6Yorkie8PresenceC","kind":"typeIdentifier","text":"Presence"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:s4Voida","kind":"typeIdentifier","text":"Void"},{"kind":"text","text":", "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"}],"title":"update(_:_:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/update(_:_:)","kind":"symbol","abstract":[{"type":"codeVoice","code":"update"},{"type":"text","text":" executes the given updater to update this document."}]},"doc://Yorkie/documentation/Yorkie/LocalChangesDroppedEvent":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedEvent","url":"\/documentation\/yorkie\/localchangesdroppedevent","type":"topic","navigatorTitle":[{"text":"LocalChangesDroppedEvent","kind":"identifier"}],"abstract":[{"type":"codeVoice","code":"LocalChangesDroppedEvent"},{"type"