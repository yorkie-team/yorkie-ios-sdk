:"text","text":"It implements Attachable interface to be managed by Attachment."}],"url":"\/documentation\/yorkie\/document","title":"Document","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Document"}],"navigatorTitle":[{"kind":"identifier","text":"Document"}],"role":"symbol","kind":"symbol"}}}