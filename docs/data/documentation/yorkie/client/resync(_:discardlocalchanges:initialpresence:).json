{"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Client"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/resync(_:discardLocalChanges:initialPresence:)","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"modules":[{"name":"Yorkie"}],"title":"resync(_:discardLocalChanges:initialPresence:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"resync","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Yorkie8DocumentC","text":"Document","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"discardLocalChanges","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"initialPresence","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Yorkie12PresenceDataa","text":"PresenceData","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"preciseIdentifier":"s:6Yorkie13DroppedChangeV","text":"DroppedChange","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"extendedModule":"Yorkie","externalID":"s:6Yorkie6ClientC6resync_19discardLocalChanges15initialPresenceSayAA13DroppedChangeVGAA8DocumentC_SbSDySSSe_SEpGSgtYaKF","role":"symbol"},"abstract":[{"type":"text","text":"Recovers a document whose local writes the server has refused, without dropping the"},{"type":"text","text":" "},{"type":"text","text":"client and the "},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document","isActive":true,"type":"reference"},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resync"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"doc"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document","text":"Document","preciseIdentifier":"s:6Yorkie8DocumentC"},{"kind":"text","text":", "},{"kind":"externalParam","text":"discardLocalChanges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initialPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/PresenceData","text":"PresenceData","preciseIdentifier":"s:6Yorkie12PresenceDataa"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DroppedChange","text":"DroppedChange","preciseIdentifier":"s:6Yorkie13DroppedChangeV"},{"kind":"text","text":"]"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The attached document to recover.","type":"text"}]}],"name":"doc"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Must be ","type":"text"},{"type":"codeVoice","code":"true"},{"text":". The un-pushed changes are taken out of the queue","type":"text"},{"text":" ","type":"text"},{"text":"and returned instead of being sent again; there is no non-discarding form, and the","type":"text"},{"text":" ","type":"text"},{"text":"argument keeps the data loss visible at the call site.","type":"text"}]}],"name":"discardLocalChanges"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The presence to re-attach with. Defaults to the document’s current","type":"text"},{"text":" ","type":"text"},{"text":"presence, so the user keeps their cursor: presence is not what the server refused.","type":"text"}]}],"name":"initialPresence"}],"kind":"parameters"},{"content":[{"anchor":"return-value","level":2,"type":"heading","text":"Return Value"},{"inlineContent":[{"type":"text","text":"The discarded changes, so the app can report them. Re-applying them is"},{"type":"text","text":" "},{"type":"text","text":"deliberately not the default."}],"type":"paragraph"}],"kind":"content"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"An auth webhook that starts denying writes mid-session (a locked document, a member"},{"type":"text","text":" "},{"type":"text","text":"downgraded to read-only, a revoked share link) leaves the refused changes in the queue."},{"type":"text","text":" "},{"type":"text","text":"Push and pull share one RPC, so every later sync re-sends them, is denied again, and the"},{"type":"text","text":" "},{"type":"text","text":"client stops receiving other peers’ changes too. The refused changes cannot be undone in"},{"type":"text","text":" "},{"type":"text","text":"place either: they are already applied to the root and there is no server-confirmed copy"},{"type":"text","text":" "},{"type":"text","text":"to fall back on. Recovery therefore re-anchors the same "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document"},{"type":"text","text":" instance on the"},{"type":"text","text":" "},{"type":"text","text":"server state:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wait out any in-flight sync, then drop offline persistence and take the un-pushed"},{"type":"text","text":" "},{"type":"text","text":"changes out of the queue."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Detach without the presence-clear change a detach normally mints, so the pack carries"},{"type":"text","text":" "},{"type":"text","text":"no changes a webhook could refuse and the "},{"type":"codeVoice","code":"clientSeq"},{"type":"text","text":" counter never has to be rewound."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset the document for re-anchoring and attach it again under the sync mode, garbage"},{"type":"text","text":" "},{"type":"text","text":"collection option and poll interval it had, with the presence it held."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Restart the sync loop that the denial stopped."}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Keeping the instance is the point: the app’s subscriptions and the editor bound to the","type":"text"},{"text":" ","type":"text"},{"text":"document survive. Between the discard and the re-anchor the queue has a ","type":"text"},{"type":"codeVoice","code":"clientSeq"},{"text":" hole","type":"text"},{"text":" ","type":"text"},{"text":"no new change may be minted over, so the discard suspends minting: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/update(_:_:)","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/undo()","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/redo()","isActive":true},{"text":" throw ","type":"text"},{"type":"codeVoice","code":"YorkieError\/Code\/errRefused"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/isMintable","isActive":true},{"text":" is ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" until the re-anchor. An edit made before the discard is","type":"text"},{"text":" ","type":"text"},{"text":"part of the discarded set and is reported with the rest.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A detach the server refuses restores the queue and leaves the document attached as it was,","type":"text"},{"text":" ","type":"text"},{"text":"so the call can be retried. Offline persistence is the exception, as in yorkie-js-sdk: it","type":"text"},{"text":" ","type":"text"},{"text":"is torn down before the detach and stays down until the next attach. Past the detach the changes are gone for good and are published","type":"text"},{"text":" ","type":"text"},{"text":"as a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedEvent","isActive":true},{"text":" with reason ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedValue\/Reason-swift.enum\/writeDenied","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"before the re-attach, which can still fail.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If a teardown or another detach takes the document over while the detach is in flight,","type":"text"},{"text":" ","type":"text"},{"text":"or the app attaches it again before the re-anchor, the recovery stops there: the changes","type":"text"},{"text":" ","type":"text"},{"text":"are still reported as dropped, but the document is neither re-anchored nor re-attached,","type":"text"},{"text":" ","type":"text"},{"text":"and the call throws.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The whole recovery runs under the client’s sync semaphore, so no sync can start or be in","type":"text"},{"text":" ","type":"text"},{"text":"flight while the queue is touched.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Automatic recovery on attach denials and watch denials is not part of this call.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"YorkieError\/Code\/errClientNotActivated"},{"type":"text","text":" when the client is not active or"},{"type":"text","text":" "},{"type":"text","text":"loses its session during the detach, "},{"type":"codeVoice","code":"YorkieError\/Code\/errNotAttached"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"document is not attached or another call detaches it during the detach,"},{"type":"text","text":" "},{"type":"codeVoice","code":"YorkieError\/Code\/errNotDetached"},{"type":"text","text":" when the document is attached again before the"},{"type":"text","text":" "},{"type":"text","text":"re-anchor,"},{"type":"text","text":" "},{"type":"codeVoice","code":"YorkieError\/Code\/errInvalidArgument"},{"type":"text","text":" when "},{"type":"codeVoice","code":"discardLocalChanges"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":", or the"},{"type":"text","text":" "},{"type":"text","text":"error of the detach or the re-attach."}]}],"type":"aside","name":"Throws"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/yorkie\/client\/resync(_:discardlocalchanges:initialpresence:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Yorkie/documentation/Yorkie/LocalChangesDroppedValue/Reason-swift.enum/writeDenied":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedValue\/Reason-swift.enum\/writeDenied","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"writeDenied"}],"kind":"symbol","title":"LocalChangesDroppedValue.Reason.writeDenied","abstract":[{"text":"The server refused this client’s writes and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/resync(_:discardLocalChanges:initialPresence:)"},{"text":" ","type":"text"},{"text":"took the refused changes out of the queue to re-anchor the document.","type":"text"}],"url":"\/documentation\/yorkie\/localchangesdroppedvalue\/reason-swift.enum\/writedenied","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Document/update(_:_:)":{"kind":"symbol","abstract":[{"code":"update","type":"codeVoice"},{"text":" executes the given updater to update this document.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"update"},{"kind":"text","text":"(("},{"kind":"typeIdentifier","text":"JSONObject","preciseIdentifier":"s:6Yorkie10JSONObjectC"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Presence","preciseIdentifier":"s:6Yorkie8PresenceC"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/update(_:_:)","type":"topic","title":"update(_:_:)","role":"symbol","url":"\/documentation\/yorkie\/document\/update(_:_:)"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","title":"Yorkie","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Client/resync(_:discardLocalChanges:initialPresence:)":{"kind":"symbol","abstract":[{"text":"Recovers a document whose local writes the server has refused, without dropping the","type":"text"},{"text":" ","type":"text"},{"text":"client and the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"resync"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Document","preciseIdentifier":"s:6Yorkie8DocumentC"},{"kind":"text","text":", "},{"kind":"externalParam","text":"discardLocalChanges"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"externalParam","text":"initialPresence"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PresenceData","preciseIdentifier":"s:6Yorkie12PresenceDataa"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> ["},{"kind":"typeIdentifier","text":"DroppedChange","preciseIdentifier":"s:6Yorkie13DroppedChangeV"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/resync(_:discardLocalChanges:initialPresence:)","type":"topic","title":"resync(_:discardLocalChanges:initialPresence:)","role":"symbol","url":"\/documentation\/yorkie\/client\/resync(_:discardlocalchanges:initialpresence:)"},"doc://Yorkie/documentation/Yorkie/DroppedChange":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DroppedChange","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DroppedChange"}],"kind":"symbol","title":"DroppedChange","url":"\/documentation\/yorkie\/droppedchange","abstract":[{"text":"One un-pushed local change that offline persistence could not reconcile with the server.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"DroppedChange"}],"role":"symbol"},"doc://Yorkie/documentation/Yorkie/Client":{"kind":"symbol","abstract":[{"code":"Client","type":"codeVoice"},{"type":"text","text":" is a normal client that can communicate with the server."},{"type":"text","text":" "},{"type":"text","text":"It has documents and sends changes of the documents in local"},{"type":"text","text":" "},{"type":"text","text":"to the server to synchronize with other replicas in remote."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"navigatorTitle":[{"kind":"identifier","text":"Client"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client","type":"topic","title":"Client","role":"symbol","url":"\/documentation\/yorkie\/client"},"doc://Yorkie/documentation/Yorkie/Document/redo()":{"kind":"symbol","abstract":[{"code":"redo","type":"codeVoice"},{"text":" redoes the last undone change made to the document by the local client.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"redo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/redo()","type":"topic","title":"redo()","role":"symbol","url":"\/documentation\/yorkie\/document\/redo()"},"doc://Yorkie/documentation/Yorkie/LocalChangesDroppedEvent":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/LocalChangesDroppedEvent","url":"\/documentation\/yorkie\/localchangesdroppedevent","abstract":[{"type":"codeVoice","code":"LocalChangesDroppedEvent"},{"text":" is published when offline persistence discards un-pushed local","type":"text"},{"text":" ","type":"text"},{"text":"changes it could not reconcile with the server — a stale-epoch re-anchor, a server-side purge","type":"text"},{"text":" ","type":"text"},{"text":"of the document, a store resumed under a different actor, or an undecodable envelope.","type":"text"}],"type":"topic","title":"LocalChangesDroppedEvent","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalChangesDroppedEvent"}],"navigatorTitle":[{"kind":"identifier","text":"LocalChangesDroppedEvent"}],"role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yor