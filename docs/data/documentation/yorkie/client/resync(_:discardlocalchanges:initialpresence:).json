ext":"Document","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Document","kind":"identifier"}],"abstract":[{"text":"A CRDT-based data type. We can representing the model","type":"text"},{"text":" ","type":"text"},{"text":"of the application. And we can edit it even while offline.","type":"text"},{"text":" ","type":"text"},{"text":"It implements Attachable interface to be managed by Attachment.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document","title":"Document","kind":"symbol"},"doc://Yorkie/documentation/Yorkie/Document/undo()":{"role":"symbol","type":"topic","url":"\/documentation\/yorkie\/document\/undo()","title":"undo()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undo","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"throws","kind":"keyword"}],"abstract":[{"code":"undo","type":"codeVoice"},{"text":" undoes the last change made to the document by the local client.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/undo()"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","type":"topic","url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[]},"doc://Yorkie/documentation/Yorkie/Document/redo()":{"role":"symbol","type":"topic","url":"\/documentation\/yorkie\/document\/redo()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"redo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"throws"}],"title":"redo()","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Document\/redo()","kind":"symbol","abstract":[{"type":"codeVoice","code":"redo"},{"text":" redoes the last undone change made to the document by the local client.","type":"text"}]},"doc://Yorkie/documentation/Yorkie/LocalChangesDroppedValue/Reason-swift.enum/writeDenied":{"role":"symbol","type