inlineContent":[{"type":"text","text":"The channel is registered locally and the server is notified on the first"},{"type":"text","text":" "},{"type":"codeVoice","code":"refreshChannel(_:)"},{"type":"text","text":" (the “first-call”, carrying "},{"type":"codeVoice","code":"client_key"},{"type":"text","text":" + "},{"type":"codeVoice","code":"metadata"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"which attaches the session and returns its id. There is no longer a dedicated"},{"type":"text","text":" "},{"type":"text","text":"AttachChannel RPC — the lifecycle is consolidated onto RefreshChannel"},{"type":"text","text":" "},{"type":"text","text":"(yorkie 0.7.10). Detach likewise needs no RPC: the server reclaims the session"},{"type":"text","text":" "},{"type":"text","text":"via TTL once heartbeats stop."}]}]}],"variants":[{"paths":["\/documentation\/yorkie\/client\/attachchannel(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/attachChannel(_:)"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"code":"attachChannel","type":"codeVoice"},{"type":"text","text":" attaches the given channel to this client."}],"references":{"doc://Yorkie/documentation/Yorkie/Client/attachChannel(_:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attachChannel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Channel","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie7ChannelC"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Channel","preciseIdentifier":"s:6Yorkie7ChannelC"}],"title":"attachChannel(_:)","kind":"symbol","type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/attachChannel(_:)","url":"\/documentation\/yorkie\/client\/attachchannel(_