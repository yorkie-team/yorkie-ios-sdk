{"sections":[],"abstract":[{"code":"attachChannel","type":"codeVoice"},{"text":" attaches the given channel to this client.","type":"text"}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/attachChannel(_:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Instance Method","title":"attachChannel(_:)","symbolKind":"method","modules":[{"name":"Yorkie"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attachChannel","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Yorkie7ChannelC","text":"Channel","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:6Yorkie7ChannelC","text":"Channel","kind":"typeIdentifier"}],"externalID":"s:6Yorkie6ClientC13attachChannelyAA0D0CAFYaKF","extendedModule":"Yorkie","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Client"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/client\/attachchannel(_:)"]}],"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"kind":"text","text":" "},{"text":"@","kind":"attribute"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"attachChannel"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"_"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"channel"},{"text":": ","kind":"text"},{"text":"Channel","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Channel","preciseIdentifier":"s:6Yorkie7ChannelC"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"Channel","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Channel","preciseIdentifier":"s:6Yorkie7ChannelC"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The channel is registered locally and the server is notified on the first"},{"type":"text","text":" "},{"code":"refreshChannel(_:)","type":"codeVoice"},{"type":"text","text":" (the “first-call”, carrying "},{"code":"client_key","type":"codeVoice"},{"type":"text","text":" + "},{"code":"metadata","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"which attaches the session and returns its id. There is no longer a dedicated"},{"type":"text","text":" "},{"type":"text","text":"AttachChannel RPC — the lifecycle is consolidated onto RefreshChannel"},{"type":"text","text":" "},{"type":"text","text":"(yorkie 0.7.10). Detach likewise needs no RPC: the server reclaims the session"},{"type":"text","text":" "},{"type":"text","text":"via TTL once heartbeats stop."}]}],"kind":"content"}],"references":{"doc://Yorkie/documentation/Yorkie/Client/attachChannel(_:)":{"url":"\/documentation\/yorkie\/client\/attachchannel(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attachChannel","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:6Yorkie7ChannelC","text":"Channel","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:6Yorkie7ChannelC","text":"Channel","kind":"typeIdentifier"}],"abstract":[{"code":"attachChannel","type":"codeVoice"},{"text":" attaches the given channel to this client.","type":"text"}],"role":"symbol","type":"topic","title":"attachChannel(_:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client\/attachChannel(_:)","kind":"symbol"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","title":"Yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Client":{"title":"Client","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Client"}],"type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Client","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Client"}],"url":"\/documentation\/yorkie\/client","abstract":[{"type":"codeVoice","code":"Client"},{"type":"text","text":" is a normal client that can communicate with the server."},{"type":"text","text":" "},{"type":"text","text":"It has documents and sends changes of the documents in local"},{"type":"text","text":" "},{"type":"text","text":"to the server to synchronize with other replicas in remote."}]},"doc://Yorkie/documentation/Yorkie/Channel":{"title":"Channel","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Channel"}],"type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Channel","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Channel"}],"url":"\/documentation\/yorkie\/channel","abstract":[{"code":"Channel","type":"codeVoice"},{"type":"text","text":" represents a lightweight channel for presence and messaging."},{"type":"text","text":" "},{"type":"text","text":"It implements "},{"type":"codeVoice","code":"Attachable"},{"type":"text","text":" so it can be managed by "},{"code":"Attachment","type":"codeVoice"},{"type":"text","text":"."}]}}}