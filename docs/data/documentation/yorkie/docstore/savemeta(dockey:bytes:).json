{"metadata":{"roleHeading":"Instance Method","required":true,"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","externalID":"s:6Yorkie8DocStoreP8saveMeta6docKey5bytesySS_10Foundation4DataVtYaKF","title":"saveMeta(docKey:bytes:)","symbolKind":"method","modules":[{"name":"Yorkie"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key of the document whose header is being recorded."}]}],"name":"docKey"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The serialized header."}]}],"name":"bytes"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It leaves the snapshot alone – an online client syncs constantly, and"},{"type":"text","text":" "},{"type":"text","text":"re-snapshotting per sync would reintroduce the cost this interface exists to"},{"type":"text","text":" "},{"type":"text","text":"avoid – and it leaves the "},{"type":"strong","inlineContent":[{"type":"text","text":"log"}]},{"type":"text","text":" alone too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That second part is load-bearing. The log does two jobs: it holds un-pushed"},{"type":"text","text":" "},{"type":"text","text":"changes so they survive a reload, and it is the delta between the snapshot and"},{"type":"text","text":" "},{"type":"text","text":"the document’s current content. Deleting acknowledged entries serves the first"},{"type":"text","text":" "},{"type":"text","text":"job and destroys the second, because nothing brings the snapshot forward on a"},{"type":"text","text":" "},{"type":"text","text":"push-ack – the content would then exist in neither place while the persisted"},{"type":"text","text":" "},{"type":"codeVoice","code":"serverSeq"},{"type":"text","text":" claims the server has it. Only compaction trims the log, and it does"},{"type":"text","text":" "},{"type":"text","text":"so by folding the entries into a new snapshot first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The header itself carries the acknowledged "},{"type":"codeVoice","code":"clientSeq"},{"type":"text","text":", so a restore reads it"},{"type":"text","text":" "},{"type":"text","text":"from there; the store needs no separate parameter for it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is a no-op when nothing is stored for the key."}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"Any error the underlying storage raises."}],"type":"paragraph"}],"name":"Throws"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)"]}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"]]},"abstract":[{"type":"text","text":"Records the post-sync header."}],"references":{"doc://Yorkie/documentation/Yorkie/DocStore":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocStore"}],"abstract":[{"type":"text","text":"A pluggable persistence backend for offline document state."}],"navigatorTitle":[{"kind":"identifier","text":"DocStore"}],"url":"\/documentation\/yorkie\/docstore","title":"DocStore","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"},"doc://Yorkie/documentation/Yorkie/DocStore/saveMeta(docKey:bytes:)":{"required":true,"url":"\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"role":"symbol","title":"saveMeta(docKey:bytes:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)","kind":"symbol","abstract":[{"type":"text","text":"Records the post-sync header."}]},"doc://Yorkie/documentation/Yorkie":{"type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie","kind"