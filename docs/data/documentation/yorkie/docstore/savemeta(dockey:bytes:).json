{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)"]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"externalID":"s:6Yorkie8DocStoreP8saveMeta6docKey5bytesySS_10Foundation4DataVtYaKF","required":true,"title":"saveMeta(docKey:bytes:)","roleHeading":"Instance Method","symbolKind":"method","role":"symbol","modules":[{"name":"Yorkie"}]},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Records the post-sync header.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The key of the document whose header is being recorded."}],"type":"paragraph"}],"name":"docKey"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The serialized header."}]}],"name":"bytes"}]},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"It leaves the snapshot alone – an online client syncs constantly, and","type":"text"},{"text":" ","type":"text"},{"text":"re-snapshotting per sync would reintroduce the cost this interface exists to","type":"text"},{"text":" ","type":"text"},{"text":"avoid – and it leaves the ","type":"text"},{"inlineContent":[{"type":"text","text":"log"}],"type":"strong"},{"text":" alone too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That second part is load-bearing. The log does two jobs: it holds un-pushed"},{"type":"text","text":" "},{"type":"text","text":"changes so they survive a reload, and it is the delta between the snapshot and"},{"type":"text","text":" "},{"type":"text","text":"the document’s current content. Deleting acknowledged entries serves the first"},{"type":"text","text":" "},{"type":"text","text":"job and destroys the second, because nothing brings the snapshot forward on a"},{"type":"text","text":" "},{"type":"text","text":"push-ack – the content would then exist in neither place while the persisted"},{"type":"text","text":" "},{"code":"serverSeq","type":"codeVoice"},{"text":" claims the server has it. Only compaction trims the log, and it does","type":"text"},{"text":" ","type":"text"},{"text":"so by folding the entries into a new snapshot first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The header itself carries the acknowledged "},{"code":"clientSeq","type":"codeVoice"},{"type":"text","text":", so a restore reads it"},{"type":"text","text":" "},{"type":"text","text":"from there; the store needs no separate parameter for it."}]},{"type":"paragraph","inlineContent":[{"text":"It is a no-op when nothing is stored for the key.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Any error the underlying storage raises."}],"type":"paragraph"}],"type":"aside","name":"Throws"}],"kind":"content"}],"references":{"doc://Yorkie/documentation/Yorkie/DocStore":{"abstract":[{"type":"text","text":"A pluggable persistence backend for offline document state."}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","navigatorTitle":[{"text":"DocStore","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocStore","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/yorkie\/docstore","title":"DocStore"},"doc://Yorkie/documentation/Yorkie/DocStore/saveMeta(docKey:bytes:)":{"url":"\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)","type":"topic","required":true,"title":"saveMeta(docKey:bytes:)","kind":"symbol","abstract":[{"text":"Records the post-sync header.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic"