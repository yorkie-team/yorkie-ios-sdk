{"kind":"symbol","abstract":[{"text":"Records the post-sync header.","type":"text"}],"metadata":{"modules":[{"name":"Yorkie"}],"title":"saveMeta(docKey:bytes:)","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"required":true,"externalID":"s:6Yorkie8DocStoreP8saveMeta6docKey5bytesySS_10Foundation4DataVtYaKF","role":"symbol"},"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)"},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"docKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key of the document whose header is being recorded."}]}]},{"name":"bytes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The serialized header."}]}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"It leaves the snapshot alone – an online client syncs constantly, and","type":"text"},{"text":" ","type":"text"},{"text":"re-snapshotting per sync would reintroduce the cost this interface exists to","type":"text"},{"text":" ","type":"text"},{"text":"avoid – and it leaves the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"log"}]},{"text":" alone too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That second part is load-bearing. The log does two jobs: it holds un-pushed","type":"text"},{"text":" ","type":"text"},{"text":"changes so they survive a reload, and it is the delta between the snapshot and","type":"text"},{"text":" ","type":"text"},{"text":"the document’s current content. Deleting acknowledged entries serves the first","type":"text"},{"text":" ","type":"text"},{"text":"job and destroys the second, because nothing brings the snapshot forward on a","type":"text"},{"text":" ","type":"text"},{"text":"push-ack – the content would then exist in neither place while the persisted","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"serverSeq"},{"text":" claims the server has it. Only compaction trims the log, and it does","type":"text"},{"text":" ","type":"text"},{"text":"so by folding the entries into a new snapshot first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The header itself carries the acknowledged ","type":"text"},{"type":"codeVoice","code":"clientSeq"},{"text":", so a restore reads it","type":"text"},{"text":" ","type":"text"},{"text":"from there; the store needs no separate parameter for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It is a no-op when nothing is stored for the key.","type":"text"}]},{"style":"note","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error the underlying storage raises."}]}],"type":"aside"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)"]}],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"]]},"references":{"doc://Yorkie/documentation/Yorkie/DocStore/saveMeta(docKey:bytes:)":{"abstract":[{"text":"Records the post-sync header.","type":"text"}],"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)","type":"topic","title":"saveMeta(docKey:bytes:)","required":true,"role":"symbol","url":"\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)"},"doc://Yorkie/documentation/Yorkie/DocStore":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","abstract":[{"text":"A pluggable persistence backend for offline document state.","type":"text"}],"url":"\/documentation\/yorkie\/docstore","type":"topic","title":"DocStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocStore"}],"navigatorTitle":[{"kind":"identifier","text":"DocStore"}],"role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/docu