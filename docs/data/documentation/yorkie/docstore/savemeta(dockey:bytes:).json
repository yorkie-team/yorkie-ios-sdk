{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"docKey","content":[{"type":"paragraph","inlineContent":[{"text":"The key of the document whose header is being recorded.","type":"text"}]}]},{"name":"bytes","content":[{"type":"paragraph","inlineContent":[{"text":"The serialized header.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"It leaves the snapshot alone – an online client syncs constantly, and","type":"text"},{"text":" ","type":"text"},{"text":"re-snapshotting per sync would reintroduce the cost this interface exists to","type":"text"},{"text":" ","type":"text"},{"text":"avoid – and it leaves the ","type":"text"},{"type":"strong","inlineContent":[{"text":"log","type":"text"}]},{"text":" alone too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That second part is load-bearing. The log does two jobs: it holds un-pushed","type":"text"},{"text":" ","type":"text"},{"text":"changes so they survive a reload, and it is the delta between the snapshot and","type":"text"},{"text":" ","type":"text"},{"text":"the document’s current content. Deleting acknowledged entries serves the first","type":"text"},{"text":" ","type":"text"},{"text":"job and destroys the second, because nothing brings the snapshot forward on a","type":"text"},{"text":" ","type":"text"},{"text":"push-ack – the content would then exist in neither place while the persisted","type":"text"},{"text":" ","type":"text"},{"code":"serverSeq","type":"codeVoice"},{"text":" claims the server has it. Only compaction trims the log, and it does","type":"text"},{"text":" ","type":"text"},{"text":"so by folding the entries into a new snapshot first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The header itself carries the acknowledged ","type":"text"},{"code":"clientSeq","type":"codeVoice"},{"text":", so a restore reads it","type":"text"},{"text":" ","type":"text"},{"text":"from there; the store needs no separate parameter for it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It is a no-op when nothing is stored for the key.","type":"text"}],"type":"paragraph"},{"name":"Throws","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Any error the underlying storage raises.","type":"text"}]}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore\/saveMeta(docKey:bytes:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Records the post-sync header."}],"variants":[{"paths":["\/documentation\/yorkie\/docstore\/savemeta(dockey:bytes:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"method","roleHeading":"Instance Method","role":"symbol","required":true,"title":"saveMeta(docKey:bytes:)","modules":[{"name":"Yorkie"}],"externalID":"s:6Yorkie8DocStoreP8saveMeta6docKey5bytesySS_10Foundation4DataVtYaKF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"k