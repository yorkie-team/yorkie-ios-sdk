{"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocStore","kind":"identifier"},{"text":" : ","kind":"text"},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"It is deliberately a snapshot plus an append-only change log rather than one opaque"},{"type":"text","text":" "},{"type":"text","text":"blob. Re-serializing the whole document on every edit costs time proportional to the"},{"type":"text","text":" "},{"type":"text","text":"document – hundreds of milliseconds on a large one – and a document is at its"},{"type":"text","text":" "},{"type":"text","text":"largest while it is being edited, which is exactly when the writes happen. Appending"},{"type":"text","text":" "},{"type":"text","text":"costs the size of one change, which does not grow with the document at all."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The interface stays byte-oriented and async so a durable backend can implement it"},{"type":"text","text":" "},{"type":"text","text":"without the client knowing which storage it talks to, and so a backend is free to"},{"type":"text","text":" "},{"type":"text","text":"compress or encrypt what it is handed. The default "},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore","type":"reference","isActive":true},{"type":"text","text":" keeps"},{"type":"text","text":" "},{"type":"text","text":"everything in a process-local dictionary and carries no dependency."}],"type":"paragraph"}]}],"relationshipsSections":[{"kind":"relationships","type":"inheritsFrom","identifiers":["doc:\/\