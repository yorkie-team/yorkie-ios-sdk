,{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"},{"type":"text","text":" is shared by more than one process: two sessions resuming the same"},{"type":"text","text":" "},{"type":"text","text":"persisted document would both re-push the same un-acknowledged local changes."}],"type":"paragraph"},{"text":"Platform note","level":2,"anchor":"Platform-note","type":"heading"},{"inlineContent":[{"text":"Upstream’s default is built on the browser’s Web Locks API to keep two tabs apart,","type":"text"},{"text":" ","type":"text"},{"text":"and is documented there as a no-op outside a browser. iOS has no tabs, and an app is","type":"text"},{"text":" ","type":"text"},{"text":"a single process, so ","type":"text"},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/NoopSessionLock","isActive":true,"type":"reference"},{"text":" is the default here and matches upstream’s","type":"text"},{"text":" ","type":"text"},{"text":"own non-browser behaviour.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The hazard is still reachable on Apple platforms when a ","type":"text"},{"inlineContent":[{"text":"persistent","type":"text"}],"type":"strong"},{"text":" store is","type":"text"},{"text":" ","type":"text"},{"text":"shared across processes — an app and its share extension or widget writing to the","type":"text"},{"text":" ","type":"text"},{"text":"same App Group container. A caller who does that should supply an implementation","type":"text"},{"text":" ","type":"text"},{"text":"backed by cross-process coordination, such as ","type":"text"},{"code":"NSFileCoordinator","type":"codeVoice"},{"text":" or a lock file.","type":"text"}]}],"kind":"content"}],"references":{"doc://Yorkie/documentation/Yorkie/SessionLock/acquire(name:)":{"required":true,"role":"symbol","abstract":[{"type":"text","text":"Acquires the lease named "},{"type":"codeVoice","code":"name"},{"type":"text","text":", o