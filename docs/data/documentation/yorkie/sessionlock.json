{"abstract":[{"type":"text","text":"Guards a store-backed document against being resumed by two sessions at once."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"type":"inheritsFrom","kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Yorkie\/s8SendableP","doc:\/\/Yorkie\/s16SendableMetatypeP"]},{"type":"conformingTypes","kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/NoopSessionLock"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionLock","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"A lease is taken per attachment, keyed by the API key, client key and document key,"},{"type":"text","text":" "},{"type":"text","text":"and held for the attachment’s lifetime. It matters only when a persistent"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"},{"type":"text","text":" is shared by more than one process: two sessions resuming the same"},{"type":"text","text":" "},{"type":"text","text":"persisted document would both re-push the same un-acknowledged local changes."}],"type":"paragraph"},{"text":"Platform note","type":"heading","level":2,"anchor":"Platform-note"},{"inlineContent":[{"type":"text","text":"Upstream’s default is built on the browser’s Web Locks API to keep two tabs apart,"},{"type":"text","text":" "},{"type":"text","text":"and is documented there as a no-op outside a browser. iOS has no tabs, and an app is"},{"type":"text","text":" "},{"type":"text","text":"a single process, so "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/NoopSessionLock"},{"type":"text","text":" is the default here and matches upstream’s"},{"type":"text","text":" "},{"type":"text","text":"own non-browser behaviour."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The hazard is still reachable on Apple platforms when a "},{"type":"strong","inlineContent":[{"text":"persistent","type":"text"}]},{"type":"text","text":" store is"},{"type":"text","text":" "},{"type":"text","text":"shared across processes — an app and its share extension or widget writing to the"},{"type":"text","text":" "},{"type":"text","text":"same App Group container. A caller who does that should supply an implementation"},{"type":"text","text":" "},{"type":"text","text":"backed by cross-process coordination, such as "},{"type":"codeVoice","code":"NSFileCoordinator"},{"type":"text","text":" or a lock file."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/SessionLock","interfaceLanguage":"swift"},"metadata":{"navigatorTitle":[{"text":"SessionLock","kind":"identifier"}],"role":"symbol","modules":[{"name":"Yorkie"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionLock","kind":"identifier"}],"roleHeading":"Protocol","symbolKind":"protocol","title":"SessionLock","externalID":"s:6Yorkie11SessionLockP"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/sessionlock"]}],"sections":[],"topicSections":[{"generated":true,"title":"Instance Methods","identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/SessionLock\/acquire(name:)"],"anchor":"Instance-Methods"}],"references":{"doc://Yorkie/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/Yorkie\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://Yorkie/documentation/Yorkie/SessionLock/acquire(name:)":{"role":"sym