{"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/SessionLock\/acquire(name:)"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/SessionLock"},"relationshipsSections":[{"identifiers":["doc:\/\/Yorkie\/s8SendableP","doc:\/\/Yorkie\/s16SendableMetatypeP"],"type":"inheritsFrom","kind":"relationships","title":"Inherits From"},{"identifiers":["doc:\/\/Yorkie\/documentation\/Yorkie\/NoopSessionLock"],"type":"conformingTypes","kind":"relationships","title":"Conforming Types"}],"kind":"symbol","metadata":{"modules":[{"name":"Yorkie"}],"navigatorTitle":[{"text":"SessionLock","kind":"identifier"}],"title":"SessionLock","roleHeading":"Protocol","symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionLock","kind":"identifier"}],"externalID":"s:6Yorkie11SessionLockP","role":"symbol"},"abstract":[{"text":"Guards a store-backed document against being resumed by two sessions at once.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SessionLock","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"text":"A lease is taken per attachment, keyed by the API key, client key and document key,","type":"text"},{"text":" ","type":"text"},{"text":"and held for the attachment’s lifetime. It matters only when a persistent","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentat