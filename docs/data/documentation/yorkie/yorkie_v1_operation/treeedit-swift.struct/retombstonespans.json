{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/retombstoneSpans","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"retombstoneSpans"},{"kind":"text","text":": ["},{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"typeIdentifier","text":"Yorkie_V1_TreeRestoreSpan","preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV"},{"kind":"text","text":"] { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"],"platforms":["macOS"]}]}],"kind":"symbol","metadata":{"roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"retombstoneSpans"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","text":"Yorkie_V1_TreeRestoreSpan"},{"kind":"text","text":"]"}],"title":"retombstoneSpans","externalID":"s:6Yorkie0A13_V1_OperationV8TreeEditV16retombstoneSpansSayAA0a1_b1_D11RestoreSpanVGvp","modules":[{"name":"Yorkie"}],"symbolKind":"property","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct\/retombstonespans"]}],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct":{"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TreeEdit"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeEdit","kind":"identifier"}],"title":"Yorkie_V1_Operation.TreeEdit","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct","url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation":{"type":"topic","role":"symbol","title":"Yorkie_V1_Operation","identifier":"doc:\/\/Yorkie\/documentati