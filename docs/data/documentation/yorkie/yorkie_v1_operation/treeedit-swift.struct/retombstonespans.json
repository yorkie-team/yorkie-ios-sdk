ord"},{"text":" ","kind":"text"},{"text":"retombstoneSpans","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[],"title":"retombstoneSpans","kind":"symbol","type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/retombstoneSpans"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_Operation"}],"url":"\/documentation\/yorkie\/yorkie_v1_operation","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_Operation"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation","abstract":[],"title":"Yorkie_V1_Operation","type":"topic"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"url":"\/documentation\/yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","title":"Yorkie","kind":"symbol","type":"topic","role":"collection"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"role":"symbol","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"title":"Yorkie_V1_TreeRestoreSpan","type":"topic"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct":{"kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeEdit"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct","title":"Yorkie_V1_Operation.TreeEdit","navigatorTitle":[{"kind":"identifier","text":"TreeEdit"}],"url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct","type":"topic","role":"symbol"}}}