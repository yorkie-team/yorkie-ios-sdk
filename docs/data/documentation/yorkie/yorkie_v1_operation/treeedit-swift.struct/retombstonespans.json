nd needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct/retombstoneSpans":{"title":"retombstoneSpans","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/retombstoneSpans","kind":"symbol","role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct\/retombstonespans","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"retombstoneSpans"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","kind":"typeIdentifier","text":"Yorkie_V1_TreeRestoreSpan"},{"kind":"text","text":"]"}],"abstract":[],"type":"topic"}}}