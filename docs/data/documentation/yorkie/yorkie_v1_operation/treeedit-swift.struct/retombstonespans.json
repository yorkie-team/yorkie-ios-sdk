" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct/retombstoneSpans":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/retombstoneSpans","title":"retombstoneSpans","url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct\/retombstonespans","role":"symbol","kind":"symbol","abstract":[],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retombstoneSpans","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","kind":"typeIdentifier"},{"text":"]","kind":"text"}]}}}