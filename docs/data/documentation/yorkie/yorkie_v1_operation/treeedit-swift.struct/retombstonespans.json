{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct\/retombstonespans"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"retombstoneSpans","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"typeIdentifier"},{"text":"] { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct"]]},"metadata":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"retombstoneSpans","kind":"identifier"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","text":"Yorkie_V1_TreeRestoreSpan"},{"text":"]","kind":"text"}],"symbolKind":"property","externalID":"s:6Yorkie0A13_V1_OperationV8TreeEditV16retombstoneSpansSayAA0a1_b1_D11RestoreSpanVGvp","title":"retombstoneSpans","modules":[{"name":"Yorkie"}],"role":"symbol","roleHeading":"Instance Property"},"kind":"symbol","identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/retombstoneSpans","interfaceLanguage":"swift"},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"symbol","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"type":"topic","role":"collection","title":"Yorkie","kind":"symbol","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeEdit"}],"navigatorTitle":[{"kind":"identifier","text":"TreeEdit"}],"type":"topic","title":"Yorkie_V1_Operation.TreeEdit","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct","kind":"symbol","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_opera