ie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct/restoreSpans":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/restoreSpans","title":"restoreSpans","url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct\/restorespans","role":"symbol","kind":"symbol","abstract":[{"text":"identity-preserving undo\/redo","type":"text"}],"type":"topic","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restoreSpans","kind":"identifier"},{"text":": [","kind":"text"},{"preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","text":"Yorkie_V1_TreeRestoreSpan","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct":{"title":"Yorkie_V1_Operation.TreeEdit","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TreeEdit","kind":"identifier"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"TreeEdit","kind":"identifier"}],"url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct","abstract":[],"role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation":{"type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation","kind":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_operation","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_Operation","kind":"identifier"}],"navigatorTitle":[{"text":"Yorkie_V1_Operation","kind":"identifier"}],"abstract":[],"title":"Yorkie_V1_Operation"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"type":"text","text":" "},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"}}}