,"text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TreeEdit"}],"role":"symbol","title":"Yorkie_V1_Operation.TreeEdit","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct","kind":"symbol","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"TreeEdit"}]},"doc://Yorkie/documentation/Yorkie":{"type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation/TreeEdit-swift.struct/restoreSpans":{"url":"\/documentation\/yorkie\/yorkie_v1_operation\/treeedit-swift.struct\/restorespans","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"restoreSpans"},{"kind":"text","text":": ["},{"preciseIdentifier":"s:6Yorkie0A19_V1_TreeRestoreSpanV","kind":"typeIdentifier","text":"Yorkie_V1_TreeRestoreSpan"},{"kind":"text","text":"]"}],"role":"symbol","title":"restoreSpans","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation\/TreeEdit-swift.struct\/restoreSpans","abstract":[{"type":"text","text":"identity-preserving undo\/redo"}],"kind":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_Operation":{"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_Operation"}],"abstract":[],"navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_Operation"}],"url":"\/documentation\/yorkie\/yorkie_v1_operation","title":"Yorkie_V1_Operation","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_Operation"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]}}}