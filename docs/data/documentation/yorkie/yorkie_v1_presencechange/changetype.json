xt":" ","kind":"text"},{"text":"allCases","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Yorkie_V1_PresenceChange","preciseIdentifier":"s:6Yorkie0A18_V1_PresenceChangeV","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"ChangeType","preciseIdentifier":"s:6Yorkie0A18_V1_PresenceChangeV0D4TypeO","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_PresenceChange\/ChangeType\/allCases","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_presencechange\/changetype\/allcases","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_PresenceChange/ChangeType/patch":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_PresenceChange\/ChangeType\/patch","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"patch"}],"kind":"symbol","title":"Yorkie_V1_PresenceChange.ChangeType.patch","abstract":[{"text":"CHANGE_TYPE_PATCH carries only the top-level keys that changed since","type":"text"},{"text":" ","type":"text"},{"text":"the sender’s previous presence: set entries in presence, deleted keys","type":"text"},{"text":" ","type":"text"},{"text":"in removed_keys. Clients send it only to a server that advertises the","type":"text"},{"text":" ","type":"text"},{"text":"“presence-patch” capability on ChangePack. The server folds it into","type":"text"},{"text":" ","type":"text"},{"text":"a CHANGE_TYPE_PUT of the full presence before storing, so it never","type":"text"},{"text":" ","type":"text"},{"text":"appears in a pulled change.","type":"text"}],"url":"\/documentation\/yorkie\/yorkie_v1_presencechange\/changetype\/patch","role":"symbol"}}}