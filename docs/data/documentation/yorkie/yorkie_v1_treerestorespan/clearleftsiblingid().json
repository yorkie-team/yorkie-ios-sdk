{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearLeftSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV18clearLeftSiblingIDyyF","title":"clearLeftSiblingID()","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Yorkie"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearleftsiblingid()"]}],"abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"leftSiblingID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearLeftSiblingID()","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearLeftSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"}],"sections":[],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearLeftSiblingID()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearLeftSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"leftSiblingID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearleftsiblingid()","title":"clearLeftSiblingID()","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearLeftSiblingID()"},"doc://Yorkie/documentation/Yorkie":{"type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]}}}