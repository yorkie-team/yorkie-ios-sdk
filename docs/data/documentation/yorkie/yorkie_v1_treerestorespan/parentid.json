{"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Instance Property","modules":[{"name":"Yorkie"}],"symbolKind":"property","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV8parentIDAA0a1_b1_c4NodeG0Vvp","title":"parentID","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"parentID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV"}],"role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/parentid"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"parentID","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","text":"Yorkie_V1_TreeNodeID","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID"},{"kind":"text","text":" { "},{"text":"get","kind":"keyword"},{"kind":"text","text":" "},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/parentID","interfaceLanguage":"swift"},"kind":"symbol","references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/parentID":{"role":"symbol","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/parentID","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"parentID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","text":"Yorkie_V1_TreeNodeID"}],"title":"parentID","type":"topic","