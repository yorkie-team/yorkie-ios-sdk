wiftProtobuf"],"name":"Yorkie"}],"symbolKind":"init","extendedModule":"SwiftProtobuf","title":"init(textFormatString:options:extensions:)","role":"symbol","externalID":"s:13SwiftProtobuf7MessagePAAE16textFormatString7options10extensionsxSS_AA04TextE15DecodingOptionsVAA12ExtensionMap_pSgtKcfc::SYNTHESIZED::s:6Yorkie0A19_V1_TreeRestoreSpanV","roleHeading":"Initializer"},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(textFormatString:options:extensions:)","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/init(textformatstring:options:extensions:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/init(textFormatString:options:extensions:)":{"abstract":[],"role":"symbol","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"textFormatString"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf25TextFormatDecodingOptionsV","text":"TextFormatDecodingOptions"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extensions"},{"kind":"text","text":": (any "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP","text":"ExtensionMap"},{"kind":"text","text":")?) "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(textFormatString:options:extensions:)","type":"topic","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/init(textformatstring:options:extensions:)","title":"init(textFormatString:options:extensions:)"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"role":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","type":"topic","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","title":"Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","title":"Yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","url":"\/documentation\/yorkie"}}}