":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/hash(into:)":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/hash(into:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hash","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:s6HasherV","text":"Hasher","kind":"typeIdentifier"},{"text":")","kind":"text"}],"role":"symbol","title":"hash(into:)","identifier":"doc:\/\