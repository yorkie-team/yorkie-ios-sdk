"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/hasRightSiblingID":{"kind":"symbol","title":"hasRightSiblingID","role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/hasrightsiblingid","type":"topic","abstract":[{"text":"Returns true if ","type":"text"},{"code":"rightSiblingID","type":"codeVoice"},{"text":" has been explicitly set.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/hasRightSiblingID","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasRightSiblingID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}]}}}