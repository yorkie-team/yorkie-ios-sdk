es a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"title":"Yorkie_V1_TreeRestoreSpan","type":"topic"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"url":"\/documentation\/yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","title":"Yorkie","kind":"symbol","type":"topic","role":"collection"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/hasRightSiblingID":{"role":"symbol","kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasRightSiblingID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/hasrightsiblingid","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/hasRightSiblingID","abstract":[{"type":"text","text":"Returns true if "},{"type":"codeVoice","code":"rightSiblingID"},{"type":"text","text":" has been explicitly set."}],"title":"hasRightSiblingID","type":"topic"}}}