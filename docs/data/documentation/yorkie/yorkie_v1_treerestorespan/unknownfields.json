{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Message.unknownFields"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV","text":"UnknownStorage"}],"platforms":["macOS"]}],"kind":"declarations"}],"kind":"symbol","metadata":{"modules":[{"name":"Yorkie"}],"role":"symbol","title":"unknownFields","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13unknownFields13SwiftProtobuf14UnknownStorageVvp","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknownFields","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnknownStorage","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}],"roleHeading":"Instance Property","symbolKind":"property"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/unknownFields":{"type":"topic","role":"symbol","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields","title":"unknownFields","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"unknownFields","kind":"identifier"},{"text":": ","kind":"text"},{"text":"UnknownStorage","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV","kind":"typeIdentifier"}],"kind":"symbol"},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie"}}}