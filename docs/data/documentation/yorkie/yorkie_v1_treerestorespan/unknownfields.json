{"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnknownStorage","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}],"platforms":["macOS"]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","abstract":[{"text":"Inherited from ","type":"text"},{"code":"Message.unknownFields","type":"codeVoice"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields"]}],"metadata":{"title":"unknownFields","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13unknownFields13SwiftProtobuf14UnknownStorageVvp","role":"symbol","modules":[{"name":"Yorkie"}],"symbolKind":"property","roleHeading":"Instance Property","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnknownStorage","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}]},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/unknownFields":{"title":"unknownFields","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnknownStorage","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}],"type":"topic","kind":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields","abstract":[],"role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"type":"text","text":" "},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie":{"url":"\/documentation\/yorkie","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","role":"collection","type":"topic","title":"Yorkie"}}}