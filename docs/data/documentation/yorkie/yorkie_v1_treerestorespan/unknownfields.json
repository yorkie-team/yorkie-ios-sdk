{"abstract":[{"text":"Inherited from ","type":"text"},{"code":"Message.unknownFields","type":"codeVoice"},{"type":"text","text":"."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnknownStorage","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}]}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"text":"unknownFields","kind":"identifier"},{"kind":"text","text":": "},{"text":"UnknownStorage","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}],"modules":[{"name":"Yorkie"}],"symbolKind":"property","title":"unknownFields","role":"symbol","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13unknownFields13SwiftProtobuf14UnknownStorageVvp","roleHeading":"Instance Property"},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/unknownFields":{"abstract":[],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV","kind":"typeIdentifier","text":"UnknownStorage"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields","type":"topic","title":"unknownFields","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","title":"Yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"role":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","type":"topic","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","title":"Yorkie_V1_TreeRestoreSpan"}}}