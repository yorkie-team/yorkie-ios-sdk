gle deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/unknownFields":{"kind":"symbol","role":"symbol","type":"topic","title":"unknownFields","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/unknownFields","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/unknownfields","fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"unknownFields"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UnknownStorage","preciseIdentifier":"s:13SwiftProtobuf14UnknownStorageV"}]},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","role":"collection","type":"topic","title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"url":"\/documentation\/yorkie"}}}