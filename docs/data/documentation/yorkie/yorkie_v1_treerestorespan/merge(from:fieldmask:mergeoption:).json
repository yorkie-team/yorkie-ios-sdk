ldMaskV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"mergeOption"},{"kind":"text","text":": "},{"text":"Google_Protobuf_FieldMask","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf07Google_B10_FieldMaskV"},{"text":".","kind":"text"},{"text":"MergeOptions","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf07Google_B10_FieldMaskV12MergeOptionsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"abstract":[],"type":"topic"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","abstract":[],"url":"\/documentation\/yorkie","kind":"symbol","role":"collection"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","kind":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"}}}