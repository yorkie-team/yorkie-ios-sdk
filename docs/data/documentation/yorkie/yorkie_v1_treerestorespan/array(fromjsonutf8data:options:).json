ans and needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/array(fromJSONUTF8Data:options:)":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/array(fromjsonutf8data:options:)","type":"topic","role":"symbol","title":"array(fromJSONUTF8Data:options:)","kind":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"array"},{"kind":"text","text":"("},{"kind":"externalParam","text":"fromJSONUTF8Data"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf19JSONDecodingOptionsV","text":"JSONDecodingOptions"},{"kind":"text","text":") "},{"text":"throws","kind":"keyword"},{"text":" -> [","kind":"text"},{"text":"Self","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/array(fromJSONUTF8Data:options:)"}}}