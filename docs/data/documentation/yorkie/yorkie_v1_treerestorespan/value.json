{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/value"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}]}],"kind":"declarations"}],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"metadata":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"title":"value","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV5valueSSvp","roleHeading":"Instance Property","modules":[{"name":"Yorkie"}],"symbolKind":"property","role":"symbol"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/value"]}],"sections":[],"references":{"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/value":{"role":"symbol","title":"value","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/value","kind":"symbol","type":"topic","abstract":[],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"value","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/value"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"role":"symbol","type":"topic","abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"text":" ","type":"text"},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","title":"Yorkie_V1_TreeRestoreSpan"}}}