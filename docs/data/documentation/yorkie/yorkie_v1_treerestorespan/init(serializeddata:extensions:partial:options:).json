":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/init(serializedData:extensions:partial:options:)":{"type":"topic","role":"symbol","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/init(serializeddata:extensions:partial:options:)","title":"init(serializedData:extensions:partial:options:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(serializedData:extensions:partial:options:)","deprecated":true,"fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"serializedData","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":", ","kind":"text"},{"text":"extensions","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"ExtensionMap","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP"},{"text":")?, ","kind":"text"},{"text":"partial","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeId