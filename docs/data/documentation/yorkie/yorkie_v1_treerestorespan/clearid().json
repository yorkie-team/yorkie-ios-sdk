{"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"sections":[],"abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"id"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearID","kind":"identifier"},{"text":"()","kind":"text"}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearID()"},"metadata":{"modules":[{"name":"Yorkie"}],"title":"clearID()","symbolKind":"method","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV7clearIDyyF","role":"symbol","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearID"},{"kind":"text","text":"()"}]},"variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearid()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearID()":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearID()","role":"symbol","title":"clearID()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearID"},{"kind":"text","text":"()"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearid()","abstract":[{"type":"text","text":"Clears the value of "},{"code":"id","type":"codeVoice"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"type":"topic"},"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"type":"topic","role":"collection","title":"Yorkie","kind":"symbol","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"symbol","role":"symbol"}}}