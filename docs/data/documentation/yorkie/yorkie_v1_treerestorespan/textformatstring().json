{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"metadata":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textFormatString","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"}],"roleHeading":"Instance Method","title":"textFormatString()","modules":[{"name":"Yorkie","relatedModules":["SwiftProtobuf"]}],"externalID":"s:13SwiftProtobuf7MessagePAAE16textFormatStringSSyF::SYNTHESIZED::s:6Yorkie0A19_V1_TreeRestoreSpanV","symbolKind":"method","role":"symbol","extendedModule":"SwiftProtobuf"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/textformatstring()"]}],"abstract":[{"type":"text","text":"Inherited from "},{"type":"codeVoice","code":"Message.textFormatString()"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/textFormatString()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"textFormatString"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"}],"sections":[],"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/textFormatString()":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/textformatstring()","kind":"symbol","title":"textFormatString()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"textFormatString","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/textFormatString()","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"}}}