xt"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"title":"Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/textFormatString()":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/textformatstring()","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"textFormatString","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"type":"topic","kind":"symbol","abstract":[],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/textFormatString()","title":"textFormatString()"},"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","role":"collection","url":"\/documentation\/yorkie","abstract":[],"kind":"symbol","type":"topic","title":"Yorkie"}}}