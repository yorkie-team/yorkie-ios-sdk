toreSpan/merge(contiguousBytes:extensions:partial:options:)":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/merge(contiguousbytes:extensions:partial:options:)","kind":"symbol","title":"merge(contiguousBytes:extensions:partial:options:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"merge","kind":"identifier"},{"kind":"text","text":"<"},{"text":"Bytes","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"contiguousBytes","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bytes"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extensions"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP","kind":"typeIdentifier","text":"ExtensionMap"},{"kind":"text","text":")?, "},{"kind":"externalParam","text":"partial"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13SwiftProtobuf21BinaryDecodingOptionsV","kind":"typeIdentifier","text":"BinaryDecodingOptions"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"type":"topic","deprecated":true,"abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/merge(contiguousBytes:extensions:partial:options:)","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]}}}