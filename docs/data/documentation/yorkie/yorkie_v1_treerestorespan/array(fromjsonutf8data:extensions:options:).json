ype":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"type":"text","text":" "},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/array(fromJSONUTF8Data:extensions:options:)":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/array(fromjsonutf8data:extensions:options:)","type":"topic","role":"symbol","abstract":[],"title":"array(fromJSONUTF8Data:extensions:options:)","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"array","kind":"identifier"},{"text":"(","kind":"text"},{"text":"fromJSONUTF8Data","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"extensions","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"ExtensionMap","preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"