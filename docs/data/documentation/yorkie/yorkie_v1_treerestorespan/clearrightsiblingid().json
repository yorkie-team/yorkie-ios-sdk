{"sections":[],"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"Yorkie"}],"title":"clearRightSiblingID()","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV19clearRightSiblingIDyyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol"},"abstract":[{"text":"Clears the value of ","type":"text"},{"type":"codeVoice","code":"rightSiblingID"},{"text":". Subsequent reads from it will return its default value.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()"]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"]}],"kind":"declarations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()"},"kind":"symbol","references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearRightSiblingID()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()","abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"rightSiblingID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()","title":"clearRightSiblingID()","type":"topic","role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"kind":"symbol","title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}]},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","title":"Yorkie","role":"collection","url":"\/documentation\/yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"}}}