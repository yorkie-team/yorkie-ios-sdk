{"abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"rightSiblingID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearRightSiblingID"},{"kind":"text","text":"()"}],"languages":["swift"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV19clearRightSiblingIDyyF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearRightSiblingID"},{"kind":"text","text":"()"}],"role":"symbol","title":"clearRightSiblingID()","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"Yorkie"}]},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearRightSiblingID()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()","role":"symbol","abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"rightSiblingID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()","title":"clearRightSiblingID()"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","abstract":[],"role":"collection","url":"\/documentation\/yorkie","type":"topic","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"}}}