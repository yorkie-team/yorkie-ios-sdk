{"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"abstract":[{"text":"Clears the value of ","type":"text"},{"type":"codeVoice","code":"rightSiblingID"},{"text":". Subsequent reads from it will return its default value.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]}],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV19clearRightSiblingIDyyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"title":"clearRightSiblingID()","role":"symbol","modules":[{"name":"Yorkie"}]},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","abstract":[],"url":"\/documentation\/yorkie","kind":"symbol","role":"collection"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearRightSiblingID()":{"abstract":[{"text":"Clears the value of ","type":"text"},{"code":"rightSiblingID","type":"codeVoice"},{"text":". Subsequent reads from it will return its default value.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","type":"topic","title":"clearRightSiblingID()","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","kind":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"}}}