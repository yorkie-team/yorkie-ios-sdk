{"sections":[],"abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"rightSiblingID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()"]}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()","interfaceLanguage":"swift"},"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"Yorkie"}],"roleHeading":"Instance Method","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV19clearRightSiblingIDyyF","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"title":"clearRightSiblingID()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]}],"references":{"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","role":"collection","url":"\/documentation\/yorkie","abstract":[],"kind":"symbol","type":"topic","title":"Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearRightSiblingID()":{"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearRightSiblingID","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearRightSiblingID()","title":"clearRightSiblingID()","kind":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearrightsiblingid()","abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"rightSiblingID"},{"text":". Subsequent reads from it will return its default value.","type":"text"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"title":"Yorkie_V1_TreeRestoreSpan"}}}