t the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","title":"Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","kind":"symbol","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie"}}}