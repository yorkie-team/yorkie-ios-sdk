keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"title":"Yorkie_V1_TreeRestoreSpan","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","type":"topic","url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[]}}}