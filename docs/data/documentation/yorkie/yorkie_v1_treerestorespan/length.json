e":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"symbol","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/length":{"title":"length","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/length","abstract":[],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/length","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"length"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Int32","preciseIdentifier":"s:s5Int32V"}]}}}