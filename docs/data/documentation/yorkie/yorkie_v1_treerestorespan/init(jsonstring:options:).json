un, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"title":"Yorkie_V1_TreeRestoreSpan","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","type":"topic","url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[]}}}