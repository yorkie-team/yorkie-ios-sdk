ic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeNodeID"}],"navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeNodeID"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","kind":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treenodeid","abstract":[],"title":"Yorkie_V1_TreeNodeID"}}}