":"extensions","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"ExtensionMap","preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP","kind":"typeIdentifier"},{"text":")?, ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"JSONDecodingOptions","preciseIdentifier":"s:13SwiftProtobuf19JSONDecodingOptionsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"roleHeading":"Initializer","modules":[{"name":"Yorkie","relatedModules":["SwiftProtobuf"]}],"externalID":"s:13SwiftProtobuf7MessagePAAE13jsonUTF8Bytes10extensions7optionsxqd___AA12ExtensionMap_pSgAA19JSONDecodingOptionsVtKcAA0ab10ContiguousF0Rd__lufc::SYNTHESIZED::s:6Yorkie0A19_V1_TreeRestoreSpanV","title":"init(jsonUTF8Bytes:extensions:options:)","extendedModule":"SwiftProtobuf","role":"symbol","symbolKind":"init"},"kind":"symbol","identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(jsonUTF8Bytes:extensions:options:)","interfaceLanguage":"swift"},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/init(jsonUTF8Bytes:extensions:options:)":{"title":"init(jsonUTF8Bytes:extensions:options:)","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/init(jsonutf8bytes:extensions:options:)","abstract":[],"role":"symbol","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(jsonUTF8Bytes:extensions:options:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Bytes","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"jsonUTF8Bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bytes","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"extensions","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"ExtensionMap","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP"},{"text":")?, ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"JSONDecodingOptions","kind":"typeIdentifier","preciseIdentifier":"s:13SwiftProtobuf19JSONDecodingOptionsV"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"symbol","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"type":"topic","role":"collection","title":"Yorkie","kind":"symbol","url":"\/documen