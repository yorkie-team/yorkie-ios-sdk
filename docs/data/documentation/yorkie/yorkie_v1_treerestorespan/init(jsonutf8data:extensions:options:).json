e deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/init(jsonUTF8Data:extensions:options:)":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/init(jsonutf8data:extensions:options:)","type":"topic","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"jsonUTF8Data","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DataV"},{"text":", ","kind":"text"},{"text":"extensions","kind":"externalParam"},{"text":": (any ","kind":"text"},{"text":"ExtensionMap","preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP","kind":"typeIdentifier"},{"text":")?, ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"JSONDecodingOptions","preciseIdentifier":"s:13SwiftProtobuf19JSONDecodingOptionsV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"throws","kind":"keyword"}],"role":"symbol","title":"init(jsonUTF8Data:extensions:options:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(jsonUTF8Data:extensions:options:)","abstract":[],"kind":"symbol"}}}