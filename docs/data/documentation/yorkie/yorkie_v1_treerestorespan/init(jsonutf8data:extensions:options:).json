 it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/init(jsonUTF8Data:extensions:options:)":{"title":"init(jsonUTF8Data:extensions:options:)","abstract":[],"role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/init(jsonutf8data:extensions:options:)","type":"topic","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"jsonUTF8Data"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":", "},{"kind":"externalParam","text":"extensions"},{"kind":"text","text":": (any "},{"preciseIdentifier":"s:13SwiftProtobuf12ExtensionMapP","kind":"typeIdentifier","text":"ExtensionMap"},{"kind":"text","text":")?, "},{"kind":"externalParam","text":"options"},{"kind":"text","text":": "},{"preciseIdentifier":"s:13SwiftProtobuf19JSONDecodingOptionsV","kind":"typeIdentifier","text":"JSONDecodingOptions"},{"kind":"text","text":") "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/init(jsonUTF8Data:extensions:options:)"}}}