xt"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"role":"symbol","kind":"symbol"},"doc://Yorkie/documentation/Yorkie":{"abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","title":"Yorkie","url":"\/documentation\/yorkie"}}}