{"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"leftSiblingID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","text":"Yorkie_V1_TreeNodeID"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}],"languages":["swift"]}]}],"metadata":{"roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"leftSiblingID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV"}],"title":"leftSiblingID","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13leftSiblingIDAA0a1_b1_c4NodeH0Vvp","modules":[{"name":"Yorkie"}],"symbolKind":"property","role":"symbol"},"kind":"symbol","variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/leftsiblingid"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/leftSiblingID"},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeNodeID":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeNodeID"}],"navigatorTitle":[{"text":"Yorkie_V1_TreeNodeID","kind":"identifier"}],"title":"Yorkie_V1_TreeNodeID","kind":"symbol","type":"topic","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","url":"\/documentation\/yorkie\/yorkie_v1_treenodeid","abstract":[],"role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/leftSiblingID":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"kind":"identifier","text":"leftSiblingID"},{"kind":