/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/leftSiblingID","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"leftSiblingID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeNodeID":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","kind":"identifier"}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeNodeID","kind":"identifier"}],"kind":"symbol","title":"Yorkie_V1_TreeNodeID","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_treenodeid"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"kind":"symbol","title":"Yorkie_V1_TreeRestoreSpan","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan"}}}