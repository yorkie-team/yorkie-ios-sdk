{"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/leftSiblingID","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"leftSiblingID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","kind":"typeIdentifier"}],"role":"symbol","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13leftSiblingIDAA0a1_b1_c4NodeH0Vvp","modules":[{"name":"Yorkie"}],"title":"leftSiblingID"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/leftsiblingid"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"leftSiblingID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}]}]}],"sections":[],"kind":"symbol","references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"title":"Yorkie_V1_TreeRestoreSpan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","kind":"symbol","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/leftSiblingID":{"abstract":[],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"leftSiblingID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Yorkie_V1_TreeNodeID","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/leftsiblingid","type":"topic","title":"leftSiblingID","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/leftSiblingID","kind":"symbol","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"type":"topic","role":"collection","title":"Yorkie","kind":"symbol","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeNodeID":{"abstract":[],"fragments":[{"text":"st