{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearParentID()"},"abstract":[{"type":"text","text":"Clears the value of "},{"code":"parentID","type":"codeVoice"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearParentID","kind":"identifier"},{"text":"()","kind":"text"}]}],"kind":"declarations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearparentid()"]}],"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearParentID"},{"kind":"text","text":"()"}],"modules":[{"name":"Yorkie"}],"title":"clearParentID()","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13clearParentIDyyF","roleHeading":"Instance Method","symbolKind":"method","role":"symbol"},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearParentID()":{"abstract":[{"type":"text","text":"Clears the value of "},{"type":"codeVoice","code":"parentID"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearParentID()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearParentID","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearparentid()","title":"clearParentID()"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","abstract":[],"url":"\/documentation\/yorkie","kind":"symbol","role":"collection"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","role":"symbol","title":"Yorkie_V1_TreeRestoreSpan","kind":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"}}}