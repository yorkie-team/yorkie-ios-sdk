{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearParentID()"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearParentID"},{"kind":"text","text":"()"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearparentid()"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Clears the value of "},{"code":"parentID","type":"codeVoice"},{"type":"text","text":". Subsequent reads from it will return its default value."}],"sections":[],"metadata":{"role":"symbol","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV13clearParentIDyyF","title":"clearParentID()","roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearParentID","kind":"identifier"},{"text":"()","kind":"text"}],"symbolKind":"method","modules":[{"name":"Yorkie"}]},"references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/clearParentID()":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/clearParentID()","type":"topic","role":"symbol","title":"clearParentID()","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/clearparentid()","abstract":[{"text":"Clears the value of ","type":"text"},{"code":"parentID","type":"codeVoice"},{"text":". Subsequent reads from it will return its default value.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearParentID","kind":"identifier"},{"text":"()","kind":"text"}],"kind":"symbol"},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]}}}