ct":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","type":"topic","title":"Yorkie","url":"\/documentation\/yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_NodeAttr":{"navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_NodeAttr"}],"title":"Yorkie_V1_NodeAttr","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Yorkie_V1_NodeAttr"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_NodeAttr","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_nodeattr","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/attributes":{"title":"attributes","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"attributes"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SD","kind":"typeIdentifier","text":"Dictionary"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"preciseIdentifier":"s:6Yorkie0A12_V1_NodeAttrV","kind":"typeIdentifier","text":"Yorkie_V1_NodeAttr"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/attributes","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/attributes","role":"symbol"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"role":"symbol","kind":"symbol"}}}