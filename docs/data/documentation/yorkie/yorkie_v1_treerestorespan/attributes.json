{"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"kind":"symbol","metadata":{"role":"symbol","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attributes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Dictionary","kind":"typeIdentifier","preciseIdentifier":"s:SD"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"Yorkie_V1_NodeAttr","kind":"typeIdentifier","preciseIdentifier":"s:6Yorkie0A12_V1_NodeAttrV"},{"text":">","kind":"text"}],"externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV10attributesSDySSAA0a1_B9_NodeAttrVGvp","title":"attributes","modules":[{"name":"Yorkie"}]},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"attributes","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Dictionary","preciseIdentifier":"s:SD","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Yorkie_V1_NodeAttr","preciseIdentifier":"s:6Yorkie0A12_V1_NodeAttrV","kind":"typeIdentifier","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_NodeAttr"},{"text":"> { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" ","kind":"text"},{"text":"set","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/attributes"]}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/attributes","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"type":"topic","role":"symbol","abstract":[{"type":"text","text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed"},{"type":"text","text":" "},{"type":"text","text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the"},{"type":"text","text":" "},{"type":"text","text":"text RestoreSpan (flat offsets), a tree span records the node’s structure"},{"type":"text","text":" "},{"type":"text","text":"(type\/attrs) and its position anchors, because in a tree id-order is not"},{"type":"text","text":" "},{"type":"text","text":"sibling-order: left_sibling_id and right_sibling_id are redundant external"},{"type":"text","text":" "},{"type":"text","text":"boundary anchors of the deleted run, so restore can reconstruct the run’s"},{"type":"text","text":" "},{"type":"text","text":"internal order from the op’s own spans and needs only one surviving"},{"type":"text","text":" "},{"type":"text","text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node"},{"type":"text","text":" "},{"type":"text","text":"can be recreated."}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","title":"Yorkie_V1_TreeRestoreSpan","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}]},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_NodeAttr":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_NodeAttr"}],"navigatorTitle":[{"text":"Yorkie_V1_NodeAttr","kind":"identifier"}],"title":"Yorkie_V1_NodeAttr","