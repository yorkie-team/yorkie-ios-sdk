{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/hasID"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}]}]}],"abstract":[{"text":"Returns true if ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" has been explicitly set.","type":"text"}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"Yorkie"}],"symbolKind":"property","title":"hasID","externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV5hasIDSbvp","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"hasID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/hasid"]}],"kind":"symbol","references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/hasID":{"role":"symbol","abstract":[{"text":"Returns true if ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" has been explicitly set.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/hasID","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hasID","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"hasID","type":"topic","kind":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/hasid"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"kind":"symbol","title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}],"role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Yorkie_V1_TreeRestoreSpan"}]},"doc://Yorkie/documentation/Yorkie":{"kind":"symbol","title":"Yorkie","role":"collection","url":"\/documentation\/yorkie","type":"topic","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"}}}