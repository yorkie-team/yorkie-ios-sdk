{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/id","interfaceLanguage":"swift"},"metadata":{"externalID":"s:6Yorkie0A19_V1_TreeRestoreSpanV2idAA0a1_b1_C6NodeIDVvp","symbolKind":"property","roleHeading":"Instance Property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"id","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","text":"Yorkie_V1_TreeNodeID","kind":"typeIdentifier"}],"modules":[{"name":"Yorkie"}],"role":"symbol","title":"id"},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"]]},"variants":[{"paths":["\/documentation\/yorkie\/yorkie_v1_treerestorespan\/id"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","kind":"typeIdentifier","text":"Yorkie_V1_TreeNodeID"},{"kind":"text","text":" { "},{"kind":"keyword","text":"get"},{"kind":"text","text":" "},{"kind":"keyword","text":"set"},{"kind":"text","text":" }"}]}]}],"kind":"symbol","references":{"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan":{"title":"Yorkie_V1_TreeRestoreSpan","navigatorTitle":[{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"abstract":[{"text":"TreeRestoreSpan carries a tree node run from a single deletion, addressed","type":"text"},{"text":" ","type":"text"},{"text":"by TreeNodeID identity, for identity-preserving Tree undo\/redo. Unlike the","type":"text"},{"text":" ","type":"text"},{"text":"text RestoreSpan (flat offsets), a tree span records the node’s structure","type":"text"},{"text":" ","type":"text"},{"text":"(type\/attrs) and its position anchors, because in a tree id-order is not","type":"text"},{"text":" ","type":"text"},{"text":"sibling-order: left_sibling_id and right_sibling_id are redundant external","type":"text"},{"text":" ","type":"text"},{"text":"boundary anchors of the deleted run, so restore can reconstruct the run’s","type":"text"},{"text":" ","type":"text"},{"text":"internal order from the op’s own spans and needs only one surviving","type":"text"},{"text":" ","type":"text"},{"text":"boundary to place it. value\/attributes are a deep copy so a GC-purged node","type":"text"},{"text":" ","type":"text"},{"text":"can be recreated.","type":"text"}],"role":"symbol","url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Yorkie_V1_TreeRestoreSpan","kind":"identifier"}],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan"},"doc://Yorkie/documentation/Yorkie":{"title":"Yorkie","abstract":[],"role":"collection","url":"\/documentation\/yorkie","type":"topic","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeRestoreSpan/id":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"id"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Yorkie_V1_TreeNodeID","preciseIdentifier":"s:6Yorkie0A14_V1_TreeNodeIDV"}],"url":"\/documentation\/yorkie\/yorkie_v1_treerestorespan\/id","role":"symbol","kind":"symbol","abstract":[],"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeRestoreSpan\/id","type":"topic","title":"id"},"doc://Yorkie/documentation/Yorkie/Yorkie_V1_TreeNodeID":{"url":"\/documentation\/yorkie\/yorkie_v1_treenodeid","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/Yorkie_V1_TreeNodeID","fragments":[{"text":"struct","