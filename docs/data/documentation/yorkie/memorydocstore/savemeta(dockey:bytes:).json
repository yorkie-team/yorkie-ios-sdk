{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/memorydocstore\/savemeta(dockey:bytes:)"]}],"sections":[],"abstract":[{"type":"text","text":"Records the post-sync header."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore"]]},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"docKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key of the document whose header is being recorded."}]}]},{"name":"bytes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The serialized header."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"It leaves the snapshot alone – an online client syncs constantly, and"},{"type":"text","text":" "},{"type":"text","text":"re-snapshotting per sync would reintroduce the cost this interface exists to"},{"type":"text","text":" "},{"type":"text","text":"avoid – and it leaves the "},{"type":"strong","inlineContent":[{"type":"text","text":"log"}]},{"type":"text","text":" alone too."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That second part is load-bearing. The log does two jobs: it holds un-pushed"},{"type":"text","text":" "},{"type":"text","text":"changes so they survive a reload, and it is the delta between the snapshot and"},{"type":"text","text":" "},{"type":"text","text":"the document’s current content. Deleting acknowledged entries serves the first"},{"type":"text","text":" "},{"type":"text","text":"job and destroys the second, because nothing brings the snapshot forward on a"},{"type":"text","text":" "},{"type":"text","text":"push-ack – the content would then exist in neither place while the persisted"},{"type":"text","text":" "},{"type":"codeVoice","code":"serverSeq"},{"type":"text","text":" claims the server has it. Only compaction trims the log, and it does"},{"type":"text","text":" "},{"type":"text","text":"so by folding the entries into a new snapshot first."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The header itself carries the acknowledged "},{"type":"codeVoice","code":"clientSeq"},{"type":"text","text":", so a restore reads it"},{"type":"text","text":" "},{"type":"text","text":"from there; the store needs no separate parameter for it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It is a no-op when nothing is stored for the key."}],"type":"paragraph"},{"type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any error the underlying storage raises."}]}],"style":"note"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier","text":"Data"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"externalID":"s:6Yorkie14MemoryDocStoreC8saveMeta6docKey5bytesySS_10Foundation4DataVtYaKF","symbolKind":"method","title":"saveMeta(docKey:bytes:)","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"Yorkie"}]},"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore\/saveMeta(docKey:bytes:)","interfaceLanguage":"swift"},"references":{"doc://Yorkie/documentation/Yorkie/MemoryDocStore/saveMeta(docKey:bytes:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[{"type":"text","text":"Records the post-sync header."}],"url":"\/documentation\/yorkie\/memorydocstore\/savemeta(dockey:bytes:)","title":"saveMeta(docKey:bytes:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore\/saveMeta(docKey:bytes:)"},"doc://Yorkie/documentation/Yorkie/DocStore":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocStore"}],"abstract":[{"type":"text","text":"A pluggable persistence backend for offline document state."}],"navigatorTitle":[{"kind":"identifier","text":"DocStore"}],"url":"\/documentation\/yorkie\/docstore","title":"DocStore","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore"},"doc://Yorkie/documentation/Yorkie":{"type":"topic","abstract":[],"url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","role":"collection","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie"},"doc://Yorkie/documentation/Yorkie/MemoryDocStore":{"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"MemoryDocStore"}],"abstract":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","isActive":true},{"type":"text","text":" that keeps documents in memory for the lifetime of the process."}],"navigatorTitle":[{"kind":"identifier","text":"MemoryDocStore"}],"url":"\/documentation\/yorkie\/memorydocstore","title":"MemoryDocStore","kind":"symbol","role":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore"}}}