{"metadata":{"roleHeading":"Instance Method","externalID":"s:6Yorkie14MemoryDocStoreC8saveMeta6docKey5bytesySS_10Foundation4DataVtYaKF","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"saveMeta","kind":"identifier"},{"text":"(","kind":"text"},{"text":"docKey","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Data","preciseIdentifier":"s:10Foundation4DataV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"saveMeta(docKey:bytes:)","role":"symbol","modules":[{"name":"Yorkie"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Yorkie\/documentation\/Yorkie","doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore"]]},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"saveMeta"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"docKey"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"text":", ","kind":"text"},{"text":"bytes","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation4DataV","text":"Data","kind":"typeIdentifier"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"kind":"keyword","text":"throws"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"docKey","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key of the document whose header is being recorded."}]}]},{"name":"bytes","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The serialized header."}]}]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"It leaves the snapshot alone – an online client syncs constantly, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"re-snapshotting per sync would reintroduce the cost this interface exists to"},{"type":"text","text":" "},{"type":"text","text":"avoid – and it leaves the "},{"type":"strong","inlineContent":[{"text":"log","type":"text"}]},{"type":"text","text":" alone too."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That second part is load-bearing. The log does two jobs: it holds un-pushed"},{"type":"text","text":" "},{"text":"changes so they survive a reload, and it is the delta between the snapshot and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the document’s current content. Deleting acknowledged entries serves the first"},{"text":" ","type":"text"},{"text":"job and destroys the second, because nothing brings the snapshot forward on a","type":"text"},{"text":" ","type":"text"},{"text":"push-ack – the content would then exist in neither place while the persisted","type":"text"},{"text":" ","type":"text"},{"code":"serverSeq","type":"codeVoice"},{"text":" claims the server has it. Only compaction trims the log, and it does","type":"text"},{"text":" ","type":"text"},{"text":"so by folding the entries into a new snapshot first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The header itself carries the acknowledged ","type":"text"},{"code":"clientSeq","type":"codeVoice"},{"text":", so a restore reads it","type":"text"},{"text":" ","type":"text"},{"text":"from there; the store needs no separate parameter for it.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"It is a no-op when nothing is stored for the key.","type":"text"}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"text":"Any error the underlying storage raises.","type":"text"}],"type":"paragraph"}]}]}],"abstract":[{"type":"text","text":"Records the post-sync header."}],"identifier":{"url":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore\/saveMeta(docKey:bytes:)","interfaceLanguage":"swift"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/yorkie\/memorydocstore\/savemeta(dockey:bytes:)"]}],"references":{"doc://Yorkie/documentation/Yorkie/DocStore":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","url":"\/documentation\/yorkie\/docstore","type":"topic","navigatorTitle":[{"text":"DocStore","kind":"identifier"}],"abstract":[{"text":"A pluggable persistence backend for offline document state.","type":"text"}],"kind":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DocStore","kind":"identifier"}],"title":"DocStore","role":"symbol"},"doc://Yorkie/documentation/Yorkie/MemoryDocStore":{"identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore","url":"\/documentation\/yorkie\/memorydocstore","type":"topic","navigatorTitle":[{"text":"MemoryDocStore","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/DocStore","isActive":true},{"text":" that keeps documents in memory for the lifetime of the process.","type":"text"}],"kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MemoryDocStore","kind":"identifier"}],"title":"MemoryDocStore","role":"symbol"},"doc://Yorkie/documentation/Yorkie":{"role":"collection","type":"topic","url":"\/documentation\/yorkie","title":"Yorkie","kind":"symbol","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie","abstract":[]},"doc://Yorkie/documentation/Yorkie/MemoryDocStore/saveMeta(docKey:bytes:)":{"role":"symbol","type":"topic","url":"\/documentation\/yorkie\/memorydocstore\/savemeta(dockey:bytes:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"saveMeta"},{"kind":"text","text":"("},{"kind":"externalParam","text":"docKey"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":", "},{"kind":"externalParam","text":"bytes"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Data","preciseIdentifier":"s:10Foundation4DataV"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"title":"saveMeta(docKey:bytes:)","identifier":"doc:\/\/Yorkie\/documentation\/Yorkie\/MemoryDocStore\/saveMeta(docKey:bytes:)","kind":"symbol","abstract":[{"text":"Records the post-sync header.","type":"text"}]}}}